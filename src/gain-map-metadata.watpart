          (i32.sub (local.get $end) (local.get $found))))
        (if (i32.eqz (call $gain_finite (local.get $value))) (then (return (i32.const 0))))
        (f64.store (local.get $destination) (local.get $value))
        (f64.store offset=8 (local.get $destination) (local.get $value))
        (f64.store offset=16 (local.get $destination) (local.get $value))
        (return (i32.const 1))))
    ;; Element needle is <hdrgm:name>.
    (memory.copy (local.get $needle) (i32.const 35496) (i32.const 7))
    (memory.copy (i32.add (local.get $needle) (i32.const 7)) (local.get $name) (local.get $nameLen))
    (i32.store8 (i32.add (local.get $needle) (i32.add (i32.const 7) (local.get $nameLen))) (i32.const 62))
    (local.set $needleLen (i32.add (local.get $nameLen) (i32.const 8)))
    (local.set $open (call $gain_find (local.get $text) (local.get $length) (local.get $needle) (local.get $needleLen) (i32.const 0)))
    (if (i32.lt_s (local.get $open) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $close (call $gain_find (local.get $text) (local.get $length) (i32.const 35560) (i32.const 10) (local.get $open)))
    (if (i32.lt_s (local.get $close) (i32.const 0)) (then (return (i32.const 0))))
    (local.set $found (i32.add (local.get $open) (local.get $needleLen)))
    (block $itemsDone
      (loop $items
        (local.set $li (call $gain_find (local.get $text) (local.get $close) (i32.const 35616) (i32.const 8) (local.get $found)))
        (br_if $itemsDone (i32.lt_s (local.get $li) (i32.const 0)))
        (local.set $li (i32.add (local.get $li) (i32.const 8)))
        (local.set $liEnd (call $gain_find (local.get $text) (local.get $close) (i32.const 35632) (i32.const 9) (local.get $li)))
        (if (i32.lt_s (local.get $liEnd) (i32.const 0)) (then (return (i32.const 0))))
        (if (i32.ge_u (local.get $count) (i32.const 3)) (then (return (i32.const 0))))
        (local.set $value (call $gain_parse_number (i32.add (local.get $text) (local.get $li))
          (i32.sub (local.get $liEnd) (local.get $li))))
        (if (i32.eqz (call $gain_finite (local.get $value))) (then (return (i32.const 0))))
        (f64.store (i32.add (local.get $destination) (i32.mul (local.get $count) (i32.const 8))) (local.get $value))
        (local.set $count (i32.add (local.get $count) (i32.const 1)))
        (local.set $found (i32.add (local.get $liEnd) (i32.const 9)))
        (br $items)))
    (if (i32.eqz (local.get $count)) (then (return (i32.const 0))))
    (if (i32.eq (local.get $count) (i32.const 1))
      (then
        (f64.store offset=8 (local.get $destination) (f64.load (local.get $destination)))
        (f64.store offset=16 (local.get $destination) (f64.load (local.get $destination)))))
    (if (i32.ne (local.get $count) (i32.const 3)) (then (return (i32.const 0))))
    (i32.const 1))

  (func $gain_xmp_scalar (param $text i32) (param $length i32) (param $name i32) (param $nameLen i32)
    (param $fallback f64) (param $hasFallback i32) (result f64)
    (local $scratch i32)
    (local.set $scratch (i32.const 36100))
    (if (call $gain_xmp_read_channels (local.get $text) (local.get $length)
        (local.get $name) (local.get $nameLen) (local.get $scratch))
      (then (return (f64.load (local.get $scratch)))))
    (if (local.get $hasFallback) (then (return (local.get $fallback))))
    (f64.const nan))

  ;; XMP info is 8 bytes: kind (0 unrelated,1 primary,2 secondary), declared length.
  (global (export "gain_map_xmp_info_size") i32 (i32.const 8))
  (func $gain_xmp_decode_export (export "gain_map_xmp_decode")
    (param $text i32) (param $length i32) (param $metadata i32) (param $info i32) (result i32)
    (local $value f64) (local $found i32) (local $end i32)
    (local $targetMetadata i32) (local $targetInfo i32)
    (call $gain_begin)
    (if (call $gain_require_initialized) (then (return (global.get $gain_error))))
    (if (i32.or (i32.eqz (call $gain_span (local.get $text) (local.get $length)))
        (i32.eqz (call $gain_span (local.get $info) (i32.const 8))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 0)))))
    (local.set $targetInfo (local.get $info))
    (local.set $info (i32.const 36660))
    (i64.store (local.get $info) (i64.const 0))
    (if (i32.or
        (i32.lt_s (call $gain_find (local.get $text) (local.get $length) (i32.const 35080) (i32.const 37) (i32.const 0)) (i32.const 0))
        (i32.lt_s (call $gain_find (local.get $text) (local.get $length) (i32.const 35128) (i32.const 19) (i32.const 0)) (i32.const 0)))
      (then
        (memory.copy (local.get $targetInfo) (local.get $info) (i32.const 8))
        (return (i32.const 0))))
    (if (i32.or
        (i32.or
          (i32.ge_s (call $gain_find (local.get $text) (local.get $length) (i32.const 35152) (i32.const 31) (i32.const 0)) (i32.const 0))
          (i32.ge_s (call $gain_find (local.get $text) (local.get $length) (i32.const 35192) (i32.const 31) (i32.const 0)) (i32.const 0)))
        (i32.ge_s (call $gain_find (local.get $text) (local.get $length) (i32.const 35232) (i32.const 28) (i32.const 0)) (i32.const 0)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_UNSUPPORTED) (i32.const 0)))))
    (if (i32.and
        (i32.ge_s (call $gain_find (local.get $text) (local.get $length) (i32.const 35272) (i32.const 23) (i32.const 0)) (i32.const 0))
        (i32.lt_s (call $gain_find (local.get $text) (local.get $length) (i32.const 35328) (i32.const 10) (i32.const 0)) (i32.const 0)))
      (then
        (i32.store (local.get $info) (i32.const 1))
        (local.set $found (call $gain_find (local.get $text) (local.get $length) (i32.const 35304) (i32.const 13) (i32.const 0)))
        (if (i32.ge_s (local.get $found) (i32.const 0))
          (then
            (local.set $found (i32.add (local.get $found) (i32.const 13)))
            (local.set $end (local.get $found))
            (block $primaryQuoteDone
              (loop $quote
                (br_if $primaryQuoteDone (i32.ge_u (local.get $end) (local.get $length)))
                (br_if $primaryQuoteDone
                  (i32.eq (i32.load8_u (i32.add (local.get $text) (local.get $end))) (i32.const 34)))
                (local.set $end (i32.add (local.get $end) (i32.const 1)))
                (br $quote)))
            (local.set $value (call $gain_parse_number (i32.add (local.get $text) (local.get $found))
              (i32.sub (local.get $end) (local.get $found))))
            (if (i32.and
                (i32.and (call $gain_finite (local.get $value)) (f64.gt (local.get $value) (f64.const 0)))
                (f64.le (local.get $value) (f64.const 4294967295)))
              (then (i32.store offset=4 (local.get $info) (i32.trunc_f64_u (local.get $value)))))))
        (memory.copy (local.get $targetInfo) (local.get $info) (i32.const 8))
        (return (i32.const 0))))
    (if (i32.eqz (call $gain_span (local.get $metadata) (i32.const 152)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 2)))))
    (local.set $targetMetadata (local.get $metadata))
    (local.set $metadata (i32.const 36500))
    (if (i32.eqz (call $gain_xmp_read_channels (local.get $text) (local.get $length) (i32.const 35328) (i32.const 10)
        (i32.add (local.get $metadata) (i32.const 0)))) (then (return (call $gain_fail (global.get $GAIN_ERROR_XMP) (i32.const 0)))))
    (if (i32.eqz (call $gain_xmp_read_channels (local.get $text) (local.get $length) (i32.const 35344) (i32.const 10)
        (i32.add (local.get $metadata) (i32.const 24)))) (then (return (call $gain_fail (global.get $GAIN_ERROR_XMP) (i32.const 24)))))
    (if (i32.eqz (call $gain_xmp_read_channels (local.get $text) (local.get $length) (i32.const 35360) (i32.const 5)
        (i32.add (local.get $metadata) (i32.const 48)))) (then (return (call $gain_fail (global.get $GAIN_ERROR_XMP) (i32.const 48)))))
    (if (i32.eqz (call $gain_xmp_read_channels (local.get $text) (local.get $length) (i32.const 35376) (i32.const 9)
        (i32.add (local.get $metadata) (i32.const 72)))) (then (return (call $gain_fail (global.get $GAIN_ERROR_XMP) (i32.const 72)))))
    (if (i32.eqz (call $gain_xmp_read_channels (local.get $text) (local.get $length) (i32.const 35392) (i32.const 9)
        (i32.add (local.get $metadata) (i32.const 96)))) (then (return (call $gain_fail (global.get $GAIN_ERROR_XMP) (i32.const 96)))))
    (local.set $value (call $gain_xmp_scalar (local.get $text) (local.get $length) (i32.const 35408) (i32.const 14) (f64.const 0) (i32.const 1)))
    (f64.store offset=120 (local.get $metadata) (local.get $value))
    (local.set $value (call $gain_xmp_scalar (local.get $text) (local.get $length) (i32.const 35424) (i32.const 14) (f64.const 0) (i32.const 0)))
    (if (i32.eqz (call $gain_finite (local.get $value)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_XMP) (i32.const 128)))))
    (f64.store offset=128 (local.get $metadata) (local.get $value))
    (i32.store offset=136 (local.get $metadata) (i32.const 1))
    (i32.store offset=140 (local.get $metadata) (i32.const 2))
    (i32.store offset=144 (local.get $metadata)
      (if (result i32) (call $gain_all_channels_same (local.get $metadata))
        (then (i32.const 1)) (else (i32.const 3))))
    (i32.store offset=148 (local.get $metadata) (i32.const 0))
    (i32.store (local.get $info) (i32.const 2))
    (if (call $gain_metadata_validate_internal (local.get $metadata) (i32.const 0))
      (then (return (global.get $gain_error))))
    (memory.copy (local.get $targetMetadata) (local.get $metadata) (i32.const 152))
    (memory.copy (local.get $targetInfo) (local.get $info) (i32.const 8))
    (i32.const 0))

