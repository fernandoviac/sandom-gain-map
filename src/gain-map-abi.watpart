  ;; ABI authority. All public constants are immutable exported globals.
  (global $GAIN_ABI_VERSION (export "gain_map_abi_version_global") i32 (i32.const 1))
  (global $GAIN_ERROR_NOT_INITIALIZED (export "gain_map_error_not_initialized") i32 (i32.const 1))
  (global $GAIN_ERROR_SPAN (export "gain_map_error_span") i32 (i32.const 2))
  (global $GAIN_ERROR_ALIGNMENT (export "gain_map_error_alignment") i32 (i32.const 3))
  (global $GAIN_ERROR_DIMENSIONS (export "gain_map_error_dimensions") i32 (i32.const 4))
  (global $GAIN_ERROR_LAYOUT (export "gain_map_error_layout") i32 (i32.const 5))
  (global $GAIN_ERROR_SAMPLE (export "gain_map_error_sample") i32 (i32.const 6))
  (global $GAIN_ERROR_NUMERIC (export "gain_map_error_numeric") i32 (i32.const 7))
  (global $GAIN_ERROR_RECORD (export "gain_map_error_record") i32 (i32.const 8))
  (global $GAIN_ERROR_CAPACITY (export "gain_map_error_capacity") i32 (i32.const 9))
  (global $GAIN_ERROR_ALLOCATION (export "gain_map_error_allocation") i32 (i32.const 10))
  (global $GAIN_ERROR_STALE (export "gain_map_error_stale") i32 (i32.const 11))
  (global $GAIN_ERROR_ISO_VERSION (export "gain_map_error_iso_version") i32 (i32.const 12))
  (global $GAIN_ERROR_ISO_FLAGS (export "gain_map_error_iso_flags") i32 (i32.const 13))
  (global $GAIN_ERROR_TRUNCATED (export "gain_map_error_truncated") i32 (i32.const 14))
  (global $GAIN_ERROR_RATIONAL (export "gain_map_error_rational") i32 (i32.const 15))
  (global $GAIN_ERROR_XMP (export "gain_map_error_xmp") i32 (i32.const 16))
  (global $GAIN_ERROR_JPEG (export "gain_map_error_jpeg") i32 (i32.const 17))
  (global $GAIN_ERROR_MPF (export "gain_map_error_mpf") i32 (i32.const 18))
  (global $GAIN_ERROR_PROFILE (export "gain_map_error_profile") i32 (i32.const 19))
  (global $GAIN_ERROR_CONTRADICTION (export "gain_map_error_contradiction") i32 (i32.const 20))
  (global $GAIN_ERROR_CODEC (export "gain_map_error_codec") i32 (i32.const 21))
  (global $GAIN_ERROR_OVERFLOW (export "gain_map_error_overflow") i32 (i32.const 22))
  (global $GAIN_ERROR_TRAILING (export "gain_map_error_trailing") i32 (i32.const 23))
  (global $GAIN_ERROR_DUPLICATE (export "gain_map_error_duplicate") i32 (i32.const 24))
  (global $GAIN_ERROR_UNSUPPORTED (export "gain_map_error_unsupported") i32 (i32.const 25))

  (func (export "gain_map_abi_version") (result i32) (global.get $GAIN_ABI_VERSION))
  (func (export "gain_map_error_code") (result i32) (global.get $gain_error))
  (func (export "gain_map_error_field") (result i32) (global.get $gain_field))
  (func (export "gain_map_required_size") (result i32) (global.get $gain_required))

  ;; ImageDescriptor, 32 bytes: data pointer/length, dimensions, row stride,
  ;; sample type, channel layout, flags. Samples: 0=u8,1=u16,2=f32.
  ;; Layouts: 0=RGB,1=RGBA. Flags bit0=encoded sRGB, bit1=opaque.
  (global (export "gain_map_image_size") i32 (i32.const 32))
  (global (export "gain_map_image_data_offset") i32 (i32.const 0))
  (global (export "gain_map_image_data_length_offset") i32 (i32.const 4))
  (global (export "gain_map_image_width_offset") i32 (i32.const 8))
  (global (export "gain_map_image_height_offset") i32 (i32.const 12))
  (global (export "gain_map_image_row_stride_offset") i32 (i32.const 16))
  (global (export "gain_map_image_sample_type_offset") i32 (i32.const 20))
  (global (export "gain_map_image_channel_layout_offset") i32 (i32.const 24))
  (global (export "gain_map_image_flags_offset") i32 (i32.const 28))
  (global (export "gain_map_sample_u8") i32 (i32.const 0))
  (global (export "gain_map_sample_u16") i32 (i32.const 1))
  (global (export "gain_map_sample_f32") i32 (i32.const 2))
  (global (export "gain_map_layout_rgb") i32 (i32.const 0))
  (global (export "gain_map_layout_rgba") i32 (i32.const 1))
  (global (export "gain_map_image_flag_srgb") i32 (i32.const 1))
  (global (export "gain_map_image_flag_opaque") i32 (i32.const 2))

  ;; Metadata, 152 bytes. Five three-channel f64 arrays occupy 0..119;
  ;; headroom f64s are at 120/128; flags/profile/channel count at 136..147.
  (global (export "gain_map_metadata_size") i32 (i32.const 152))
  (global (export "gain_map_metadata_min_offset") i32 (i32.const 0))
  (global (export "gain_map_metadata_max_offset") i32 (i32.const 24))
  (global (export "gain_map_metadata_gamma_offset") i32 (i32.const 48))
  (global (export "gain_map_metadata_base_offset") i32 (i32.const 72))
  (global (export "gain_map_metadata_alternate_offset") i32 (i32.const 96))
  (global (export "gain_map_metadata_headroom_min_offset") i32 (i32.const 120))
  (global (export "gain_map_metadata_headroom_max_offset") i32 (i32.const 128))
  (global (export "gain_map_metadata_flags_offset") i32 (i32.const 136))
  (global (export "gain_map_metadata_profile_offset") i32 (i32.const 140))
  (global (export "gain_map_metadata_channel_count_offset") i32 (i32.const 144))
  (global (export "gain_map_metadata_flag_base_color_space") i32 (i32.const 1))
  (global (export "gain_map_profile_generated") i32 (i32.const 0))
  (global (export "gain_map_profile_iso") i32 (i32.const 1))
  (global (export "gain_map_profile_ultra_hdr") i32 (i32.const 2))

  ;; Generation options, 104 bytes: scale/base quality/map quality/reserved,
  ;; three f64 arrays (gamma/base offset/alternate offset), maximum display
  ;; boost f64, flags/reserved. Positive values are required.
  (global (export "gain_map_options_size") i32 (i32.const 104))
  (global (export "gain_map_options_scale_offset") i32 (i32.const 0))
  (global (export "gain_map_options_base_quality_offset") i32 (i32.const 4))
  (global (export "gain_map_options_map_quality_offset") i32 (i32.const 8))
  (global (export "gain_map_options_gamma_offset") i32 (i32.const 16))
  (global (export "gain_map_options_base_offset") i32 (i32.const 40))
  (global (export "gain_map_options_alternate_offset") i32 (i32.const 64))
  (global (export "gain_map_options_maximum_display_boost_offset") i32 (i32.const 88))
  (global (export "gain_map_options_flags_offset") i32 (i32.const 96))

  ;; Error summary: max absolute, mean absolute, RMS and mean relative
  ;; luminance as f64, followed by clipped/order-error u32 counts.
  (global (export "gain_map_error_summary_size") i32 (i32.const 40))
  (global (export "gain_map_error_maximum_offset") i32 (i32.const 0))
  (global (export "gain_map_error_mean_offset") i32 (i32.const 8))
  (global (export "gain_map_error_rms_offset") i32 (i32.const 16))
  (global (export "gain_map_error_luminance_offset") i32 (i32.const 24))
  (global (export "gain_map_error_clipped_offset") i32 (i32.const 32))
  (global (export "gain_map_error_channel_order_offset") i32 (i32.const 36))

  ;; Result lease: pointer,length,kind,generation. Release requires the exact
  ;; generation of the still-live allocation and clears all fields atomically.
  (global (export "gain_map_result_size") i32 (i32.const 16))
  (global (export "gain_map_result_pointer_offset") i32 (i32.const 0))
  (global (export "gain_map_result_length_offset") i32 (i32.const 4))
  (global (export "gain_map_result_kind_offset") i32 (i32.const 8))
  (global (export "gain_map_result_generation_offset") i32 (i32.const 12))
  (func $gain_result_create (param $result i32) (param $length i32) (param $kind i32) (result i32)
    (local $ptr i32)
    (if (i32.eqz (call $gain_span (local.get $result) (i32.const 16)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 0)))))
    (local.set $ptr (call $gain_alloc_internal (local.get $length)))
    (if (i32.eqz (local.get $ptr))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_ALLOCATION) (local.get $length)))))
    (i32.store (local.get $result) (local.get $ptr))
    (i32.store offset=4 (local.get $result) (local.get $length))
    (i32.store offset=8 (local.get $result) (local.get $kind))
    (i32.store offset=12 (local.get $result) (call $gain_block_generation (local.get $ptr)))
    (i32.const 0))
  (func (export "gain_map_result_alloc") (param $result i32) (param $length i32) (param $kind i32) (result i32)
    (call $gain_begin)
    (call $gain_result_create (local.get $result) (local.get $length) (local.get $kind)))
  (func (export "gain_map_result_release") (param $result i32) (result i32)
    (local $ptr i32) (local $generation i32)
    (call $gain_begin)
    (if (i32.eqz (call $gain_span (local.get $result) (i32.const 16)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 0)))))
    (local.set $ptr (i32.load (local.get $result)))
    (local.set $generation (i32.load offset=12 (local.get $result)))
    (if (i32.or (i32.eqz (local.get $ptr))
        (i32.ne (call $gain_block_generation (local.get $ptr)) (local.get $generation)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_STALE) (local.get $ptr)))))
    (drop (call $gain_free_internal (local.get $ptr)))
    (i64.store (local.get $result) (i64.const 0))
    (i64.store offset=8 (local.get $result) (i64.const 0))
    (i32.const 0))

  ;; MPF entry and adaptive inspection records.
  (global (export "gain_map_mpf_entry_size") i32 (i32.const 16))
  (global (export "gain_map_inspection_size") i32 (i32.const 64))
  (global (export "gain_map_inspection_is_gain_map_offset") i32 (i32.const 0))
  (global (export "gain_map_inspection_compatibility_offset") i32 (i32.const 4))
  (global (export "gain_map_inspection_metadata_source_offset") i32 (i32.const 8))
  (global (export "gain_map_inspection_primary_offset") i32 (i32.const 12))
  (global (export "gain_map_inspection_primary_length_offset") i32 (i32.const 16))
  (global (export "gain_map_inspection_primary_width_offset") i32 (i32.const 20))
  (global (export "gain_map_inspection_primary_height_offset") i32 (i32.const 24))
  (global (export "gain_map_inspection_primary_channels_offset") i32 (i32.const 28))
  (global (export "gain_map_inspection_map_offset") i32 (i32.const 32))
  (global (export "gain_map_inspection_map_length_offset") i32 (i32.const 36))
  (global (export "gain_map_inspection_map_width_offset") i32 (i32.const 40))
  (global (export "gain_map_inspection_map_height_offset") i32 (i32.const 44))
  (global (export "gain_map_inspection_map_channels_offset") i32 (i32.const 48))
  (global (export "gain_map_inspection_mpf_count_offset") i32 (i32.const 52))
  (global (export "gain_map_inspection_mpf_payload_offset") i32 (i32.const 56))
  (global (export "gain_map_inspection_mpf_payload_length_offset") i32 (i32.const 60))
  (global (export "gain_map_compatibility_ordinary") i32 (i32.const 0))
  (global (export "gain_map_compatibility_iso") i32 (i32.const 1))
  (global (export "gain_map_compatibility_ultra_hdr") i32 (i32.const 2))
  (global (export "gain_map_compatibility_dual") i32 (i32.const 3))

  ;; Coarse codec request, 48 bytes. Input/output spans must not overlap.
  ;; Encode consumes the declared complete image fields; decode fills them.
  (global (export "gain_map_codec_request_size") i32 (i32.const 48))
  (global (export "gain_map_codec_input_offset") i32 (i32.const 0))
  (global (export "gain_map_codec_input_length_offset") i32 (i32.const 4))
  (global (export "gain_map_codec_output_offset") i32 (i32.const 8))
  (global (export "gain_map_codec_output_capacity_offset") i32 (i32.const 12))
  (global (export "gain_map_codec_width_offset") i32 (i32.const 16))
  (global (export "gain_map_codec_height_offset") i32 (i32.const 20))
  (global (export "gain_map_codec_row_stride_offset") i32 (i32.const 24))
  (global (export "gain_map_codec_sample_type_offset") i32 (i32.const 28))
  (global (export "gain_map_codec_channel_layout_offset") i32 (i32.const 32))
  (global (export "gain_map_codec_quality_offset") i32 (i32.const 36))
  (global (export "gain_map_codec_output_length_offset") i32 (i32.const 40))
  (global (export "gain_map_codec_flags_offset") i32 (i32.const 44))
  (func $gain_codec_call (param $request i32) (param $decode i32) (result i32)
    (local $status i32) (local $input i32) (local $inputLength i32)
    (local $output i32) (local $capacity i32) (local $produced i32)
    (local $width i32) (local $height i32) (local $stride i32)
    (local $sampleBytes i32) (local $channels i32) (local $rowBytes i32) (local $required i64)
    (call $gain_begin)
    (if (i32.eqz (global.get $gain_initialized))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_NOT_INITIALIZED) (i32.const 0)))))
    (if (i32.eqz (call $gain_span (local.get $request) (i32.const 48)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 0)))))
    (local.set $input (i32.load (local.get $request)))
    (local.set $inputLength (i32.load offset=4 (local.get $request)))
    (local.set $output (i32.load offset=8 (local.get $request)))
    (local.set $capacity (i32.load offset=12 (local.get $request)))
    (if (i32.or
        (i32.or (i32.eqz (local.get $inputLength)) (i32.eqz (local.get $capacity)))
        (i32.or
          (i32.eqz (call $gain_span (local.get $input) (local.get $inputLength)))
          (i32.eqz (call $gain_span (local.get $output) (local.get $capacity)))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 0)))))
    (if (i32.eqz (call $gain_nonoverlap
        (local.get $input) (local.get $inputLength) (local.get $output) (local.get $capacity)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 8)))))
    (if (i32.eqz (local.get $decode))
      (then
        (if (i32.or
            (i32.or (i32.eqz (i32.load offset=16 (local.get $request)))
              (i32.eqz (i32.load offset=20 (local.get $request))))
            (i32.or
              (i32.gt_u (i32.load offset=28 (local.get $request)) (i32.const 2))
              (i32.gt_u (i32.load offset=32 (local.get $request)) (i32.const 1))))
          (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD) (i32.const 16)))))
        (if (i32.gt_u (i32.load offset=36 (local.get $request)) (i32.const 100))
          (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD) (i32.const 36)))))
        (local.set $width (i32.load offset=16 (local.get $request)))
        (local.set $height (i32.load offset=20 (local.get $request)))
        (local.set $stride (i32.load offset=24 (local.get $request)))
        (local.set $sampleBytes
          (if (result i32) (i32.eq (i32.load offset=28 (local.get $request)) (i32.const 2))
            (then (i32.const 4))
            (else (i32.add (i32.load offset=28 (local.get $request)) (i32.const 1)))))
        (local.set $channels (i32.add (i32.load offset=32 (local.get $request)) (i32.const 3)))
        (local.set $rowBytes (call $gain_checked_product (local.get $width)
          (i32.mul (local.get $channels) (local.get $sampleBytes))))
        (if (i32.or (i32.lt_s (local.get $rowBytes) (i32.const 0))
            (i32.lt_u (local.get $stride) (local.get $rowBytes)))
          (then (return (call $gain_fail (global.get $GAIN_ERROR_DIMENSIONS) (i32.const 24)))))
        (local.set $required (i64.add
          (i64.mul (i64.extend_i32_u (i32.sub (local.get $height) (i32.const 1)))
            (i64.extend_i32_u (local.get $stride)))
          (i64.extend_i32_u (local.get $rowBytes))))
        (if (i64.gt_u (local.get $required) (i64.extend_i32_u (local.get $inputLength)))
          (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 4)))))))
    (i32.store offset=40 (local.get $request) (i32.const 0))
    (local.set $status
      (if (result i32) (local.get $decode)
        (then (call $host_jpeg_decode (local.get $request)))
        (else (call $host_jpeg_encode (local.get $request)))))
    (if (local.get $status)
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CODEC) (local.get $status)))))
    (local.set $produced (i32.load offset=40 (local.get $request)))
    (if (i32.or (i32.eqz (local.get $produced)) (i32.gt_u (local.get $produced) (local.get $capacity)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CODEC) (local.get $produced)))))
    (i32.const 0))
  (func (export "gain_map_jpeg_encode") (param $request i32) (result i32)
    (call $gain_codec_call (local.get $request) (i32.const 0)))
  (func (export "gain_map_jpeg_decode") (param $request i32) (result i32)
    (call $gain_codec_call (local.get $request) (i32.const 1)))
