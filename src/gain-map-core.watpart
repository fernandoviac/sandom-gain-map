  ;; Numeric gain-map preparation and recovery. All ratios, extrema,
  ;; interpolation coordinates and summaries are f64; image write points are f32.

  (func $gain_image_validate (param $record i32) (result i32)
    (local $data i32) (local $length i32) (local $width i32) (local $height i32)
    (local $stride i32) (local $sample i32) (local $layout i32)
    (local $sampleBytes i32) (local $channels i32) (local $rowBytes i32) (local $required i64)
    (if (i32.eqz (call $gain_span (local.get $record) (i32.const 32)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 0)))))
    (local.set $data (i32.load (local.get $record)))
    (local.set $length (i32.load offset=4 (local.get $record)))
    (local.set $width (i32.load offset=8 (local.get $record)))
    (local.set $height (i32.load offset=12 (local.get $record)))
    (local.set $stride (i32.load offset=16 (local.get $record)))
    (local.set $sample (i32.load offset=20 (local.get $record)))
    (local.set $layout (i32.load offset=24 (local.get $record)))
    (if (i32.or (i32.eqz (local.get $width)) (i32.eqz (local.get $height)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_DIMENSIONS) (i32.const 8)))))
    (if (i32.gt_u (local.get $sample) (i32.const 2))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SAMPLE) (i32.const 20)))))
    (if (i32.gt_u (local.get $layout) (i32.const 1))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_LAYOUT) (i32.const 24)))))
    (local.set $sampleBytes
      (if (result i32) (i32.eq (local.get $sample) (i32.const 2))
        (then (i32.const 4))
        (else (i32.add (local.get $sample) (i32.const 1)))))
    (local.set $channels (i32.add (local.get $layout) (i32.const 3)))
    (local.set $rowBytes (call $gain_checked_product (local.get $width)
      (i32.mul (local.get $channels) (local.get $sampleBytes))))
    (if (i32.or (i32.lt_s (local.get $rowBytes) (i32.const 0))
        (i32.lt_u (local.get $stride) (local.get $rowBytes)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_DIMENSIONS) (i32.const 16)))))
    (local.set $required
      (i64.add
        (i64.mul (i64.extend_i32_u (i32.sub (local.get $height) (i32.const 1)))
          (i64.extend_i32_u (local.get $stride)))
        (i64.extend_i32_u (local.get $rowBytes))))
    (if (i64.gt_u (local.get $required) (i64.extend_i32_u (local.get $length)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 4)))))
    (if (i32.eqz (call $gain_span (local.get $data) (local.get $length)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 0)))))
    (if (i32.and (i32.ne (local.get $sampleBytes) (i32.const 1))
        (i32.ne (i32.and (local.get $data) (i32.sub (local.get $sampleBytes) (i32.const 1))) (i32.const 0)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_ALIGNMENT) (i32.const 0)))))
    (i32.const 0))

  (func $gain_require_initialized (result i32)
    (if (result i32) (global.get $gain_initialized)
      (then (i32.const 0))
      (else (call $gain_fail (global.get $GAIN_ERROR_NOT_INITIALIZED) (i32.const 0)))))

  (func $gain_sample (param $image i32) (param $x i32) (param $y i32) (param $channel i32) (result f64)
    (local $base i32) (local $sample i32) (local $channels i32)
    (local.set $sample (i32.load offset=20 (local.get $image)))
    (local.set $channels (i32.add (i32.load offset=24 (local.get $image)) (i32.const 3)))
    (local.set $base
      (i32.add (i32.load (local.get $image))
        (i32.add
          (i32.mul (local.get $y) (i32.load offset=16 (local.get $image)))
          (i32.mul (i32.add (i32.mul (local.get $x) (local.get $channels)) (local.get $channel))
            (if (result i32) (i32.eq (local.get $sample) (i32.const 2))
              (then (i32.const 4))
              (else (i32.add (local.get $sample) (i32.const 1))))))))
    (if (result f64) (i32.eqz (local.get $sample))
      (then (f64.div (f64.convert_i32_u (i32.load8_u (local.get $base))) (f64.const 255)))
      (else
        (if (result f64) (i32.eq (local.get $sample) (i32.const 1))
          (then (f64.div (f64.convert_i32_u (i32.load16_u (local.get $base))) (f64.const 65535)))
          (else (f64.promote_f32 (f32.load (local.get $base))))))))

  (func $gain_store_f32 (param $image i32) (param $x i32) (param $y i32) (param $channel i32) (param $value f64)
    (local $channels i32) (local $address i32)
    (local.set $channels (i32.add (i32.load offset=24 (local.get $image)) (i32.const 3)))
    (local.set $address
      (i32.add (i32.load (local.get $image))
        (i32.add (i32.mul (local.get $y) (i32.load offset=16 (local.get $image)))
          (i32.mul (i32.add (i32.mul (local.get $x) (local.get $channels)) (local.get $channel)) (i32.const 4)))))
    (f32.store (local.get $address) (f32.demote_f64 (local.get $value))))

  (func $gain_base_pixel (param $image i32) (param $x i32) (param $y i32)
    (call $store_vec (call $VEC)
      (call $srgb_decode (call $gain_sample (local.get $image) (local.get $x) (local.get $y) (i32.const 0)))
      (call $srgb_decode (call $gain_sample (local.get $image) (local.get $x) (local.get $y) (i32.const 1)))
      (call $srgb_decode (call $gain_sample (local.get $image) (local.get $x) (local.get $y) (i32.const 2))))
    (call $apply (i32.const 0) (call $VEC) (call $VEC))
    (call $apply (i32.const 5) (call $VEC) (call $VEC)))

  (func $gain_metadata_validate_internal (param $metadata i32) (param $positiveOffsets i32) (result i32)
    (local $channel i32) (local $field i32) (local $value f64)
    (if (i32.eqz (call $gain_span (local.get $metadata) (i32.const 152)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 0)))))
    (local.set $field (i32.const 0))
    (block $fieldsDone
      (loop $fields
        (local.set $channel (i32.const 0))
        (loop $channels
          (local.set $value
            (f64.load (i32.add (local.get $metadata)
              (i32.add (local.get $field) (i32.mul (local.get $channel) (i32.const 8))))))
          (if (i32.eqz (call $gain_finite (local.get $value)))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (local.get $field) (i32.mul (local.get $channel) (i32.const 8)))))))
          (if (i32.and (i32.eq (local.get $field) (i32.const 48)) (f64.le (local.get $value) (f64.const 0)))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (local.get $field) (i32.mul (local.get $channel) (i32.const 8)))))))
          (if (i32.and (i32.or (i32.eq (local.get $field) (i32.const 72))
              (i32.eq (local.get $field) (i32.const 96)))
              (if (result i32) (local.get $positiveOffsets)
                (then (f64.le (local.get $value) (f64.const 0)))
                (else (f64.lt (local.get $value) (f64.const 0)))))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (local.get $field) (i32.mul (local.get $channel) (i32.const 8)))))))
          (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
          (br_if $channels (i32.lt_u (local.get $channel) (i32.const 3))))
        (local.set $field (i32.add (local.get $field) (i32.const 24)))
        (br_if $fields (i32.lt_u (local.get $field) (i32.const 120)))))
    (local.set $channel (i32.const 0))
    (loop $bounds
      (if (f64.lt
          (f64.load (i32.add (local.get $metadata) (i32.add (i32.const 24) (i32.mul (local.get $channel) (i32.const 8)))))
          (f64.load (i32.add (local.get $metadata) (i32.mul (local.get $channel) (i32.const 8)))))
        (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD)
          (i32.add (i32.const 24) (i32.mul (local.get $channel) (i32.const 8)))))))
      (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
      (br_if $bounds (i32.lt_u (local.get $channel) (i32.const 3))))
    (if (i32.or
        (i32.eqz (call $gain_finite (f64.load offset=120 (local.get $metadata))))
        (i32.or
          (i32.eqz (call $gain_finite (f64.load offset=128 (local.get $metadata))))
          (i32.or
            (f64.lt (f64.load offset=120 (local.get $metadata)) (f64.const 0))
            (f64.le (f64.load offset=128 (local.get $metadata))
              (f64.load offset=120 (local.get $metadata))))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD) (i32.const 120)))))
    (if (i32.gt_u (i32.load offset=136 (local.get $metadata)) (i32.const 1))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD) (i32.const 136)))))
    (if (i32.gt_u (i32.load offset=140 (local.get $metadata)) (i32.const 2))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD) (i32.const 140)))))
    (if (i32.and
        (i32.ne (i32.load offset=144 (local.get $metadata)) (i32.const 1))
        (i32.ne (i32.load offset=144 (local.get $metadata)) (i32.const 3)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD) (i32.const 144)))))
    (if (i32.and
        (i32.eq (i32.load offset=144 (local.get $metadata)) (i32.const 1))
        (i32.eqz (call $gain_all_channels_same (local.get $metadata))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD) (i32.const 144)))))
    (if (i32.and
        (i32.ne (i32.load offset=140 (local.get $metadata)) (i32.const 1))
        (i32.ne (i32.load offset=148 (local.get $metadata)) (i32.const 0)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD) (i32.const 148)))))
    (if (i32.and
        (i32.ne (i32.load offset=140 (local.get $metadata)) (i32.const 1))
        (i32.ne (i32.load offset=136 (local.get $metadata)) (i32.const 1)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD) (i32.const 136)))))
    (i32.const 0))

  (func (export "gain_map_metadata_validate") (param $metadata i32) (result i32)
    (call $gain_begin)
    (if (call $gain_require_initialized) (then (return (global.get $gain_error))))
    (call $gain_metadata_validate_internal (local.get $metadata) (i32.const 0)))

  (func (export "gain_map_options_init") (param $options i32) (result i32)
    (call $gain_begin)
    (if (i32.eqz (call $gain_span (local.get $options) (i32.const 104)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 0)))))
    (memory.fill (local.get $options) (i32.const 0) (i32.const 104))
    (i32.store (local.get $options) (i32.const 1))
    (i32.store offset=4 (local.get $options) (i32.const 90))
    (i32.store offset=8 (local.get $options) (i32.const 90))
    (f64.store offset=16 (local.get $options) (f64.const 1))
    (f64.store offset=24 (local.get $options) (f64.const 1))
    (f64.store offset=32 (local.get $options) (f64.const 1))
    (f64.store offset=40 (local.get $options) (f64.const 0.015625))
    (f64.store offset=48 (local.get $options) (f64.const 0.015625))
    (f64.store offset=56 (local.get $options) (f64.const 0.015625))
    (f64.store offset=64 (local.get $options) (f64.const 0.015625))
    (f64.store offset=72 (local.get $options) (f64.const 0.015625))
    (f64.store offset=80 (local.get $options) (f64.const 0.015625))
    (f64.store offset=88 (local.get $options) (f64.const 4))
    (i32.const 0))

  (func $gain_options_validate (param $options i32) (result i32)
    (local $scale i32) (local $channel i32) (local $offset i32) (local $value f64)
    (if (i32.eqz (call $gain_span (local.get $options) (i32.const 104)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 0)))))
    (local.set $scale (i32.load (local.get $options)))
    (if (i32.eqz (i32.or (i32.eq (local.get $scale) (i32.const 1))
        (i32.or (i32.eq (local.get $scale) (i32.const 2))
          (i32.or (i32.eq (local.get $scale) (i32.const 4))
            (i32.eq (local.get $scale) (i32.const 8))))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD) (i32.const 0)))))
    (if (i32.or (i32.gt_u (i32.load offset=4 (local.get $options)) (i32.const 100))
        (i32.gt_u (i32.load offset=8 (local.get $options)) (i32.const 100)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_RECORD) (i32.const 4)))))
    (local.set $offset (i32.const 16))
    (loop $arrays
      (local.set $channel (i32.const 0))
      (loop $values
        (local.set $value (f64.load (i32.add (local.get $options)
          (i32.add (local.get $offset) (i32.mul (local.get $channel) (i32.const 8))))))
        (if (i32.or (i32.eqz (call $gain_finite (local.get $value)))
            (f64.le (local.get $value) (f64.const 0)))
          (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
            (i32.add (local.get $offset) (i32.mul (local.get $channel) (i32.const 8)))))))
        (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
        (br_if $values (i32.lt_u (local.get $channel) (i32.const 3))))
      (local.set $offset (i32.add (local.get $offset) (i32.const 24)))
      (br_if $arrays (i32.lt_u (local.get $offset) (i32.const 88))))
    (local.set $value (f64.load offset=88 (local.get $options)))
    (if (i32.or (i32.eqz (call $gain_finite (local.get $value))) (f64.lt (local.get $value) (f64.const 1)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC) (i32.const 88)))))
    (i32.const 0))

  ;; Complete SDR-base preparation through the composed color kernel.
  (func (export "gain_map_prepare_base")
    (param $alternate i32) (param $sourcePeak f64) (param $output i32) (result i32)
    (local $x i32) (local $y i32) (local $c i32) (local $alpha f64) (local $value f64)
    (local $scratch i32) (local $outputData i32) (local $outputLength i32)
    (call $gain_begin)
    (if (call $gain_require_initialized) (then (return (global.get $gain_error))))
    (if (call $gain_image_validate (local.get $alternate)) (then (return (global.get $gain_error))))
    (if (i32.eqz (call $gain_span (local.get $output) (i32.const 32)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 2)))))
    (if (i32.or
        (i32.ne (i32.load offset=20 (local.get $alternate)) (i32.const 2))
        (i32.ne (i32.load offset=24 (local.get $alternate)) (i32.const 1)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_LAYOUT) (i32.const 20)))))
    (if (i32.or (i32.eqz (call $gain_finite (local.get $sourcePeak)))
        (f64.lt (local.get $sourcePeak) (f64.const 203)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC) (i32.const 1)))))
    ;; Validate every input sample before either the descriptor or pixel buffer
    ;; can be published.
    (loop $validateRows
      (local.set $x (i32.const 0))
      (loop $validateColumns
        (local.set $alpha (call $gain_sample (local.get $alternate) (local.get $x) (local.get $y) (i32.const 3)))
        (if (f64.ne (local.get $alpha) (f64.const 1))
          (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
            (i32.add (i32.mul (local.get $y) (i32.load offset=8 (local.get $alternate))) (local.get $x))))))
        (local.set $c (i32.const 0))
        (loop $validateChannels
          (local.set $value (call $gain_sample (local.get $alternate)
            (local.get $x) (local.get $y) (local.get $c)))
          (if (i32.or (i32.eqz (call $gain_finite (local.get $value)))
              (f64.lt (local.get $value) (f64.const 0)))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (i32.mul
                (i32.add (i32.mul (local.get $y) (i32.load offset=8 (local.get $alternate))) (local.get $x))
                (i32.const 4)) (local.get $c))))))
          (local.set $c (i32.add (local.get $c) (i32.const 1)))
          (br_if $validateChannels (i32.lt_u (local.get $c) (i32.const 3))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $validateColumns (i32.lt_u (local.get $x) (i32.load offset=8 (local.get $alternate)))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $validateRows (i32.lt_u (local.get $y) (i32.load offset=12 (local.get $alternate)))))
    ;; Validate the final descriptor in private scratch, retaining only the
    ;; caller-provided pointer and capacity.
    (local.set $scratch (i32.const 39000))
    (memory.fill (local.get $scratch) (i32.const 0) (i32.const 32))
    (local.set $outputData (i32.load (local.get $output)))
    (local.set $outputLength (i32.load offset=4 (local.get $output)))
    (i32.store (local.get $scratch) (local.get $outputData))
    (i32.store offset=4 (local.get $scratch) (local.get $outputLength))
    (i32.store offset=8 (local.get $scratch) (i32.load offset=8 (local.get $alternate)))
    (i32.store offset=12 (local.get $scratch) (i32.load offset=12 (local.get $alternate)))
    (i32.store offset=16 (local.get $scratch) (i32.mul (i32.load offset=8 (local.get $alternate)) (i32.const 16)))
    (i32.store offset=20 (local.get $scratch) (i32.const 2))
    (i32.store offset=24 (local.get $scratch) (i32.const 1))
    (i32.store offset=28 (local.get $scratch) (i32.const 3))
    (if (call $gain_image_validate (local.get $scratch)) (then (return (global.get $gain_error))))
    (if (i32.eqz (call $gain_nonoverlap
        (local.get $outputData) (local.get $outputLength)
        (i32.load (local.get $alternate)) (i32.load offset=4 (local.get $alternate))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 2)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $output) (i32.const 32)
        (local.get $outputData) (local.get $outputLength)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 2)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $output) (i32.const 32)
        (local.get $alternate) (i32.const 32)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 2)))))
    (memory.copy (local.get $output) (local.get $scratch) (i32.const 32))
    (local.set $y (i32.const 0))
    (loop $rows
      (local.set $x (i32.const 0))
      (loop $columns
        (call $store_vec (call $VEC)
          (call $gain_sample (local.get $alternate) (local.get $x) (local.get $y) (i32.const 0))
          (call $gain_sample (local.get $alternate) (local.get $x) (local.get $y) (i32.const 1))
          (call $gain_sample (local.get $alternate) (local.get $x) (local.get $y) (i32.const 2)))
        (call $tone_map_bt2390 (local.get $sourcePeak) (f64.const 203))
        (call $gamut_map_css_color_4 (i32.const 1) (i32.const 0) (i32.const 0))
        (call $gain_store_f32 (local.get $output) (local.get $x) (local.get $y) (i32.const 0)
          (call $srgb_encode (call $load0 (call $VEC))))
        (call $gain_store_f32 (local.get $output) (local.get $x) (local.get $y) (i32.const 1)
          (call $srgb_encode (call $load1 (call $VEC))))
        (call $gain_store_f32 (local.get $output) (local.get $x) (local.get $y) (i32.const 2)
          (call $srgb_encode (call $load2 (call $VEC))))
        (call $gain_store_f32 (local.get $output) (local.get $x) (local.get $y) (i32.const 3) (f64.const 1))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $columns (i32.lt_u (local.get $x) (i32.load offset=8 (local.get $alternate)))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_u (local.get $y) (i32.load offset=12 (local.get $alternate)))))
    (i32.const 0))

  (func $gain_log_gain (param $base i32) (param $alternate i32)
    (param $options i32) (param $x i32) (param $y i32) (param $channel i32) (result f64)
    (local $b f64) (local $a f64)
    (call $gain_base_pixel (local.get $base) (local.get $x) (local.get $y))
    (local.set $b (f64.load (i32.add (call $VEC) (i32.mul (local.get $channel) (i32.const 8)))))
    (local.set $a (call $gain_sample (local.get $alternate) (local.get $x) (local.get $y) (local.get $channel)))
    (call $log2
      (f64.div
        (f64.add (local.get $a)
          (f64.load (i32.add (local.get $options) (i32.add (i32.const 64) (i32.mul (local.get $channel) (i32.const 8))))))
        (f64.add (local.get $b)
          (f64.load (i32.add (local.get $options) (i32.add (i32.const 40) (i32.mul (local.get $channel) (i32.const 8)))))))))

  (func (export "gain_map_generate")
    (param $base i32) (param $alternate i32) (param $options i32)
    (param $gainImage i32) (param $metadata i32) (result i32)
    (local $width i32) (local $height i32) (local $scale i32) (local $outWidth i32) (local $outHeight i32)
    (local $x i32) (local $y i32) (local $sx i32) (local $sy i32) (local $sxEnd i32) (local $syEnd i32)
    (local $channel i32) (local $index i32) (local $sampleCount i32)
    (local $value f64) (local $minimum f64) (local $maximum f64) (local $range f64)
    (local $normalized f64) (local $sum f32) (local $outPtr i32) (local $outLength i32)
    (local $descriptor i32) (local $workMetadata i32)
    (call $gain_begin)
    (if (call $gain_require_initialized) (then (return (global.get $gain_error))))
    (if (call $gain_image_validate (local.get $base)) (then (return (global.get $gain_error))))
    (if (call $gain_image_validate (local.get $alternate)) (then (return (global.get $gain_error))))
    (if (call $gain_options_validate (local.get $options)) (then (return (global.get $gain_error))))
    (if (i32.eqz (call $gain_span (local.get $gainImage) (i32.const 32)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 3)))))
    (if (i32.eqz (call $gain_span (local.get $metadata) (i32.const 152)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 4)))))
    (local.set $descriptor (i32.const 39000))
    (local.set $workMetadata (i32.const 38000))
    (if (i32.or
        (i32.or (i32.ne (i32.load offset=20 (local.get $base)) (i32.const 2))
          (i32.ne (i32.load offset=24 (local.get $base)) (i32.const 1)))
        (i32.eqz (i32.and (i32.load offset=28 (local.get $base)) (i32.const 1))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_LAYOUT) (i32.const 0)))))
    (if (i32.or
        (i32.ne (i32.load offset=20 (local.get $alternate)) (i32.const 2))
        (i32.ne (i32.load offset=24 (local.get $alternate)) (i32.const 1)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_LAYOUT) (i32.const 1)))))
    (local.set $width (i32.load offset=8 (local.get $base)))
    (local.set $height (i32.load offset=12 (local.get $base)))
    (if (i32.or (i32.ne (local.get $width) (i32.load offset=8 (local.get $alternate)))
        (i32.ne (local.get $height) (i32.load offset=12 (local.get $alternate))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_DIMENSIONS) (i32.const 1)))))
    ;; Validate opaque alpha and all calculation samples before output publication.
    (loop $validateRows
      (local.set $x (i32.const 0))
      (loop $validateColumns
        (if (i32.or
            (f64.ne (call $gain_sample (local.get $base) (local.get $x) (local.get $y) (i32.const 3)) (f64.const 1))
            (f64.ne (call $gain_sample (local.get $alternate) (local.get $x) (local.get $y) (i32.const 3)) (f64.const 1)))
          (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
            (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x))))))
        (call $gain_base_pixel (local.get $base) (local.get $x) (local.get $y))
        (local.set $channel (i32.const 0))
        (loop $validateChannels
          (local.set $value (f64.load (i32.add (call $VEC) (i32.mul (local.get $channel) (i32.const 8)))))
          (if (i32.or (i32.eqz (call $gain_finite (local.get $value))) (f64.lt (local.get $value) (f64.const 0)))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (i32.mul (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)) (i32.const 3)) (local.get $channel))))))
          (local.set $value (call $gain_sample (local.get $alternate) (local.get $x) (local.get $y) (local.get $channel)))
          (if (i32.or (i32.eqz (call $gain_finite (local.get $value))) (f64.lt (local.get $value) (f64.const 0)))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (i32.const 0x40000000)
                (i32.add (i32.mul (i32.add (i32.mul (local.get $y) (local.get $width)) (local.get $x)) (i32.const 3)) (local.get $channel)))))))
          (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
          (br_if $validateChannels (i32.lt_u (local.get $channel) (i32.const 3))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $validateColumns (i32.lt_u (local.get $x) (local.get $width))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $validateRows (i32.lt_u (local.get $y) (local.get $height))))
    ;; Extrema pass.
    (local.set $channel (i32.const 0))
    (loop $extremaChannels
      (local.set $minimum (f64.const inf))
      (local.set $maximum (f64.const -inf))
      (local.set $y (i32.const 0))
      (loop $extremaRows
        (local.set $x (i32.const 0))
        (loop $extremaColumns
          (local.set $value (call $gain_log_gain (local.get $base) (local.get $alternate)
            (local.get $options) (local.get $x) (local.get $y) (local.get $channel)))
          (local.set $minimum (f64.min (local.get $minimum) (local.get $value)))
          (local.set $maximum (f64.max (local.get $maximum) (local.get $value)))
          (local.set $x (i32.add (local.get $x) (i32.const 1)))
          (br_if $extremaColumns (i32.lt_u (local.get $x) (local.get $width))))
        (local.set $y (i32.add (local.get $y) (i32.const 1)))
        (br_if $extremaRows (i32.lt_u (local.get $y) (local.get $height))))
      (f64.store (i32.add (local.get $workMetadata) (i32.mul (local.get $channel) (i32.const 8))) (local.get $minimum))
      (f64.store (i32.add (local.get $workMetadata) (i32.add (i32.const 24) (i32.mul (local.get $channel) (i32.const 8)))) (local.get $maximum))
      (f64.store (i32.add (local.get $workMetadata) (i32.add (i32.const 48) (i32.mul (local.get $channel) (i32.const 8))))
        (f64.load (i32.add (local.get $options) (i32.add (i32.const 16) (i32.mul (local.get $channel) (i32.const 8))))))
      (f64.store (i32.add (local.get $workMetadata) (i32.add (i32.const 72) (i32.mul (local.get $channel) (i32.const 8))))
        (f64.load (i32.add (local.get $options) (i32.add (i32.const 40) (i32.mul (local.get $channel) (i32.const 8))))))
      (f64.store (i32.add (local.get $workMetadata) (i32.add (i32.const 96) (i32.mul (local.get $channel) (i32.const 8))))
        (f64.load (i32.add (local.get $options) (i32.add (i32.const 64) (i32.mul (local.get $channel) (i32.const 8))))))
      (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
      (br_if $extremaChannels (i32.lt_u (local.get $channel) (i32.const 3))))
    (f64.store offset=120 (local.get $workMetadata) (f64.const 0))
    (local.set $maximum (f64.const 0.0009765625))
    (local.set $channel (i32.const 0))
    (loop $headroomChannels
      (local.set $maximum (f64.max (local.get $maximum)
        (f64.load (i32.add (local.get $workMetadata) (i32.add (i32.const 24) (i32.mul (local.get $channel) (i32.const 8)))))))
      (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
      (br_if $headroomChannels (i32.lt_u (local.get $channel) (i32.const 3))))
    (local.set $maximum (f64.max (local.get $maximum) (call $log2 (f64.load offset=88 (local.get $options)))))
    (f64.store offset=128 (local.get $workMetadata) (local.get $maximum))
    (i32.store offset=136 (local.get $workMetadata) (i32.const 1))
    (i32.store offset=140 (local.get $workMetadata) (i32.const 0))
    (i32.store offset=144 (local.get $workMetadata) (i32.const 3))
    (i32.store offset=148 (local.get $workMetadata) (i32.const 0))
    ;; Prepare the caller-owned gain image descriptor and validate capacity.
    (local.set $scale (i32.load (local.get $options)))
    (local.set $outWidth (i32.div_u (i32.add (local.get $width) (i32.sub (local.get $scale) (i32.const 1))) (local.get $scale)))
    (local.set $outHeight (i32.div_u (i32.add (local.get $height) (i32.sub (local.get $scale) (i32.const 1))) (local.get $scale)))
    (local.set $outPtr (i32.load (local.get $gainImage)))
    (local.set $outLength (i32.load offset=4 (local.get $gainImage)))
    (memory.fill (local.get $descriptor) (i32.const 0) (i32.const 32))
    (i32.store offset=8 (local.get $descriptor) (local.get $outWidth))
    (i32.store offset=12 (local.get $descriptor) (local.get $outHeight))
    (i32.store offset=16 (local.get $descriptor) (i32.mul (local.get $outWidth) (i32.const 12)))
    (i32.store offset=20 (local.get $descriptor) (i32.const 2))
    (i32.store offset=24 (local.get $descriptor) (i32.const 0))
    (i32.store offset=28 (local.get $descriptor) (i32.const 2))
    (i32.store (local.get $descriptor) (local.get $outPtr))
    (i32.store offset=4 (local.get $descriptor) (local.get $outLength))
    (if (call $gain_image_validate (local.get $descriptor)) (then (return (global.get $gain_error))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $outPtr) (local.get $outLength)
        (i32.load (local.get $base)) (i32.load offset=4 (local.get $base))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 3)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $outPtr) (local.get $outLength)
        (i32.load (local.get $alternate)) (i32.load offset=4 (local.get $alternate))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 3)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $outPtr) (local.get $outLength)
        (local.get $metadata) (i32.const 152)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $gainImage) (i32.const 32)
        (local.get $metadata) (i32.const 152)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $gainImage) (i32.const 32)
        (local.get $outPtr) (local.get $outLength)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 3)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $gainImage) (i32.const 32)
        (local.get $base) (i32.const 32)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 3)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $gainImage) (i32.const 32)
        (local.get $alternate) (i32.const 32)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 3)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $gainImage) (i32.const 32)
        (local.get $options) (i32.const 104)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 3)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $metadata) (i32.const 152)
        (local.get $base) (i32.const 32)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $metadata) (i32.const 152)
        (local.get $alternate) (i32.const 32)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $metadata) (i32.const 152)
        (local.get $options) (i32.const 104)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $metadata) (i32.const 152)
        (i32.load (local.get $base)) (i32.load offset=4 (local.get $base))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $metadata) (i32.const 152)
        (i32.load (local.get $alternate)) (i32.load offset=4 (local.get $alternate))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (memory.copy (local.get $metadata) (local.get $workMetadata) (i32.const 152))
    (memory.copy (local.get $gainImage) (local.get $descriptor) (i32.const 32))
    ;; Deterministic ceiling-sized box reduction. Accumulation demotes after
    ;; every addition, exactly matching a Float32Array target.
    (local.set $y (i32.const 0))
    (loop $outputRows
      (local.set $x (i32.const 0))
      (loop $outputColumns
        (local.set $sxEnd (call $gain_min_u (local.get $width) (i32.mul (i32.add (local.get $x) (i32.const 1)) (local.get $scale))))
        (local.set $syEnd (call $gain_min_u (local.get $height) (i32.mul (i32.add (local.get $y) (i32.const 1)) (local.get $scale))))
        (local.set $sampleCount
          (i32.mul (i32.sub (local.get $sxEnd) (i32.mul (local.get $x) (local.get $scale)))
            (i32.sub (local.get $syEnd) (i32.mul (local.get $y) (local.get $scale)))))
        (local.set $channel (i32.const 0))
        (loop $outputChannels
          (local.set $sum (f32.const 0))
          (local.set $sy (i32.mul (local.get $y) (local.get $scale)))
          (loop $sourceRows
            (local.set $sx (i32.mul (local.get $x) (local.get $scale)))
            (loop $sourceColumns
              (local.set $value (call $gain_log_gain (local.get $base) (local.get $alternate)
                (local.get $options) (local.get $sx) (local.get $sy) (local.get $channel)))
              (local.set $minimum (f64.load (i32.add (local.get $metadata) (i32.mul (local.get $channel) (i32.const 8)))))
              (local.set $maximum (f64.load (i32.add (local.get $metadata)
                (i32.add (i32.const 24) (i32.mul (local.get $channel) (i32.const 8))))))
              (local.set $range (f64.sub (local.get $maximum) (local.get $minimum)))
              (local.set $normalized
                (if (result f64) (f64.eq (local.get $range) (f64.const 0))
                  (then (f64.const 0))
                  (else (f64.min (f64.max
                    (f64.div (f64.sub (local.get $value) (local.get $minimum)) (local.get $range))
                    (f64.const 0)) (f64.const 1)))))
              (local.set $value (f64.load (i32.add (local.get $options)
                (i32.add (i32.const 16) (i32.mul (local.get $channel) (i32.const 8))))))
              (local.set $normalized
                (if (result f64) (f64.eq (local.get $value) (f64.const 1))
                  (then (local.get $normalized))
                  (else (call $pow (local.get $normalized) (local.get $value)))))
              (local.set $sum
                (f32.demote_f64
                  (f64.add (f64.promote_f32 (local.get $sum))
                    (f64.div
                      (f64.promote_f32 (f32.demote_f64 (local.get $normalized)))
                      (f64.convert_i32_u (local.get $sampleCount))))))
              (local.set $sx (i32.add (local.get $sx) (i32.const 1)))
              (br_if $sourceColumns (i32.lt_u (local.get $sx) (local.get $sxEnd))))
            (local.set $sy (i32.add (local.get $sy) (i32.const 1)))
            (br_if $sourceRows (i32.lt_u (local.get $sy) (local.get $syEnd))))
          (local.set $value (f64.div
            (f64.floor (f64.add (f64.mul (f64.promote_f32 (local.get $sum)) (f64.const 255)) (f64.const 0.5)))
            (f64.const 255)))
          (call $gain_store_f32 (local.get $gainImage) (local.get $x) (local.get $y) (local.get $channel) (local.get $value))
          (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
          (br_if $outputChannels (i32.lt_u (local.get $channel) (i32.const 3))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $outputColumns (i32.lt_u (local.get $x) (local.get $outWidth))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $outputRows (i32.lt_u (local.get $y) (local.get $outHeight))))
    (i32.const 0))

  (func $gain_recovery_at (param $image i32) (param $targetWidth i32) (param $targetHeight i32)
    (param $x i32) (param $y i32) (param $channel i32) (result f64)
    (local $sourceX f64) (local $sourceY f64) (local $fx f64) (local $fy f64)
    (local $x0 i32) (local $x1 i32) (local $y0 i32) (local $y1 i32)
    (local $top f64) (local $bottom f64)
    (local.set $sourceX (f64.sub (f64.div
      (f64.mul (f64.add (f64.convert_i32_u (local.get $x)) (f64.const 0.5))
        (f64.convert_i32_u (i32.load offset=8 (local.get $image))))
      (f64.convert_i32_u (local.get $targetWidth))) (f64.const 0.5)))
    (local.set $sourceY (f64.sub (f64.div
      (f64.mul (f64.add (f64.convert_i32_u (local.get $y)) (f64.const 0.5))
        (f64.convert_i32_u (i32.load offset=12 (local.get $image))))
      (f64.convert_i32_u (local.get $targetHeight))) (f64.const 0.5)))
    (local.set $x0 (i32.trunc_f64_s (f64.floor (local.get $sourceX))))
    (local.set $y0 (i32.trunc_f64_s (f64.floor (local.get $sourceY))))
    (if (i32.lt_s (local.get $x0) (i32.const 0)) (then (local.set $x0 (i32.const 0))))
    (if (i32.lt_s (local.get $y0) (i32.const 0)) (then (local.set $y0 (i32.const 0))))
    (if (i32.ge_u (local.get $x0) (i32.load offset=8 (local.get $image)))
      (then (local.set $x0 (i32.sub (i32.load offset=8 (local.get $image)) (i32.const 1)))))
    (if (i32.ge_u (local.get $y0) (i32.load offset=12 (local.get $image)))
      (then (local.set $y0 (i32.sub (i32.load offset=12 (local.get $image)) (i32.const 1)))))
    (local.set $x1 (call $gain_min_u (i32.sub (i32.load offset=8 (local.get $image)) (i32.const 1))
      (i32.add (local.get $x0) (i32.const 1))))
    (local.set $y1 (call $gain_min_u (i32.sub (i32.load offset=12 (local.get $image)) (i32.const 1))
      (i32.add (local.get $y0) (i32.const 1))))
    (local.set $fx (f64.min (f64.max
      (f64.sub (local.get $sourceX) (f64.convert_i32_s (local.get $x0))) (f64.const 0)) (f64.const 1)))
    (local.set $fy (f64.min (f64.max
      (f64.sub (local.get $sourceY) (f64.convert_i32_s (local.get $y0))) (f64.const 0)) (f64.const 1)))
    (local.set $top (f64.add
      (f64.mul (call $gain_sample (local.get $image) (local.get $x0) (local.get $y0) (local.get $channel))
        (f64.sub (f64.const 1) (local.get $fx)))
      (f64.mul (call $gain_sample (local.get $image) (local.get $x1) (local.get $y0) (local.get $channel)) (local.get $fx))))
    (local.set $bottom (f64.add
      (f64.mul (call $gain_sample (local.get $image) (local.get $x0) (local.get $y1) (local.get $channel))
        (f64.sub (f64.const 1) (local.get $fx)))
      (f64.mul (call $gain_sample (local.get $image) (local.get $x1) (local.get $y1) (local.get $channel)) (local.get $fx))))
    (f64.add (f64.mul (local.get $top) (f64.sub (f64.const 1) (local.get $fy)))
      (f64.mul (local.get $bottom) (local.get $fy))))

  (func (export "gain_map_reconstruct")
    (param $base i32) (param $gainImage i32) (param $metadata i32)
    (param $displayBoost f64) (param $output i32) (result i32)
    (local $x i32) (local $y i32) (local $channel i32) (local $weight f64)
    (local $stored f64) (local $recovery f64) (local $minimum f64) (local $maximum f64)
    (local $boost f64) (local $baseValue f64) (local $value f64)
    (local $descriptor i32) (local $outputData i32) (local $outputLength i32)
    (call $gain_begin)
    (if (call $gain_require_initialized) (then (return (global.get $gain_error))))
    (if (call $gain_image_validate (local.get $base)) (then (return (global.get $gain_error))))
    (if (call $gain_image_validate (local.get $gainImage)) (then (return (global.get $gain_error))))
    (if (call $gain_metadata_validate_internal (local.get $metadata) (i32.const 0))
      (then (return (global.get $gain_error))))
    (if (i32.eqz (call $gain_span (local.get $output) (i32.const 32)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 4)))))
    (if (i32.or
        (i32.or (i32.gt_u (i32.load offset=20 (local.get $base)) (i32.const 2))
          (i32.gt_u (i32.load offset=24 (local.get $base)) (i32.const 1)))
        (i32.eqz (i32.and (i32.load offset=28 (local.get $base)) (i32.const 1))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_LAYOUT) (i32.const 0)))))
    (if (i32.or
        (i32.ne (i32.load offset=20 (local.get $gainImage)) (i32.const 2))
        (i32.ne (i32.load offset=24 (local.get $gainImage)) (i32.const 0)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_LAYOUT) (i32.const 1)))))
    (if (i32.or (i32.gt_u (i32.load offset=8 (local.get $gainImage)) (i32.load offset=8 (local.get $base)))
        (i32.gt_u (i32.load offset=12 (local.get $gainImage)) (i32.load offset=12 (local.get $base))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_DIMENSIONS) (i32.const 1)))))
    (if (i32.or (i32.eqz (call $gain_finite (local.get $displayBoost)))
        (f64.le (local.get $displayBoost) (f64.const 0)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC) (i32.const 3)))))
    ;; Validate all source samples before publishing the output descriptor or
    ;; writing any output pixel.
    (local.set $y (i32.const 0))
    (loop $validateBaseRows
      (local.set $x (i32.const 0))
      (loop $validateBaseColumns
        (local.set $channel (i32.const 0))
        (loop $validateBaseChannels
          (local.set $value (call $gain_sample (local.get $base)
            (local.get $x) (local.get $y) (local.get $channel)))
          (if (i32.eqz (call $gain_finite (local.get $value)))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (i32.mul
                (i32.add (i32.mul (local.get $y) (i32.load offset=8 (local.get $base))) (local.get $x))
                (i32.const 3)) (local.get $channel))))))
          (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
          (br_if $validateBaseChannels (i32.lt_u (local.get $channel) (i32.const 3))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $validateBaseColumns (i32.lt_u (local.get $x) (i32.load offset=8 (local.get $base)))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $validateBaseRows (i32.lt_u (local.get $y) (i32.load offset=12 (local.get $base)))))
    (local.set $y (i32.const 0))
    (loop $validateGainRows
      (local.set $x (i32.const 0))
      (loop $validateGainColumns
        (local.set $channel (i32.const 0))
        (loop $validateGainChannels
          (local.set $value (call $gain_sample (local.get $gainImage)
            (local.get $x) (local.get $y) (local.get $channel)))
          (if (i32.or
              (i32.eqz (call $gain_finite (local.get $value)))
              (i32.or (f64.lt (local.get $value) (f64.const 0))
                (f64.gt (local.get $value) (f64.const 1))))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (i32.const 0x40000000)
                (i32.add (i32.mul
                  (i32.add (i32.mul (local.get $y) (i32.load offset=8 (local.get $gainImage))) (local.get $x))
                  (i32.const 3)) (local.get $channel)))))))
          (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
          (br_if $validateGainChannels (i32.lt_u (local.get $channel) (i32.const 3))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $validateGainColumns (i32.lt_u (local.get $x) (i32.load offset=8 (local.get $gainImage)))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $validateGainRows (i32.lt_u (local.get $y) (i32.load offset=12 (local.get $gainImage)))))
    (local.set $descriptor (i32.const 39000))
    (memory.fill (local.get $descriptor) (i32.const 0) (i32.const 32))
    (local.set $outputData (i32.load (local.get $output)))
    (local.set $outputLength (i32.load offset=4 (local.get $output)))
    (i32.store (local.get $descriptor) (local.get $outputData))
    (i32.store offset=4 (local.get $descriptor) (local.get $outputLength))
    (i32.store offset=8 (local.get $descriptor) (i32.load offset=8 (local.get $base)))
    (i32.store offset=12 (local.get $descriptor) (i32.load offset=12 (local.get $base)))
    (i32.store offset=16 (local.get $descriptor) (i32.mul (i32.load offset=8 (local.get $base)) (i32.const 16)))
    (i32.store offset=20 (local.get $descriptor) (i32.const 2))
    (i32.store offset=24 (local.get $descriptor) (i32.const 1))
    (i32.store offset=28 (local.get $descriptor) (i32.const 2))
    (if (call $gain_image_validate (local.get $descriptor)) (then (return (global.get $gain_error))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $outputData) (local.get $outputLength)
        (i32.load (local.get $base)) (i32.load offset=4 (local.get $base))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $outputData) (local.get $outputLength)
        (i32.load (local.get $gainImage)) (i32.load offset=4 (local.get $gainImage))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $outputData) (local.get $outputLength)
        (local.get $metadata) (i32.const 152)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $output) (i32.const 32)
        (local.get $outputData) (local.get $outputLength)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $output) (i32.const 32)
        (local.get $base) (i32.const 32)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $output) (i32.const 32)
        (local.get $gainImage) (i32.const 32)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (if (i32.eqz (call $gain_nonoverlap (local.get $output) (i32.const 32)
        (local.get $metadata) (i32.const 152)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4)))))
    (memory.copy (local.get $output) (local.get $descriptor) (i32.const 32))
    (local.set $weight (f64.min (f64.max
      (f64.div
        (f64.sub (call $log2 (local.get $displayBoost)) (f64.load offset=120 (local.get $metadata)))
        (f64.sub (f64.load offset=128 (local.get $metadata)) (f64.load offset=120 (local.get $metadata))))
      (f64.const 0)) (f64.const 1)))
    (local.set $y (i32.const 0))
    (loop $rows
      (local.set $x (i32.const 0))
      (loop $columns
        (call $gain_base_pixel (local.get $base) (local.get $x) (local.get $y))
        (local.set $channel (i32.const 0))
        (loop $channels
          (local.set $baseValue (f64.load (i32.add (call $VEC) (i32.mul (local.get $channel) (i32.const 8)))))
          (local.set $stored (call $gain_recovery_at (local.get $gainImage)
            (i32.load offset=8 (local.get $base)) (i32.load offset=12 (local.get $base))
            (local.get $x) (local.get $y) (local.get $channel)))
          (local.set $value (f64.load (i32.add (local.get $metadata)
            (i32.add (i32.const 48) (i32.mul (local.get $channel) (i32.const 8))))))
          (local.set $recovery
            (if (result f64) (f64.eq (local.get $value) (f64.const 1))
              (then (local.get $stored))
              (else (call $pow (local.get $stored) (f64.div (f64.const 1) (local.get $value))))))
          (local.set $minimum (f64.load (i32.add (local.get $metadata) (i32.mul (local.get $channel) (i32.const 8)))))
          (local.set $maximum (f64.load (i32.add (local.get $metadata)
            (i32.add (i32.const 24) (i32.mul (local.get $channel) (i32.const 8))))))
          (local.set $boost (f64.add (local.get $minimum)
            (f64.mul (f64.sub (local.get $maximum) (local.get $minimum)) (local.get $recovery))))
          (local.set $value (f64.max (f64.const 0)
            (f64.sub
              (f64.mul
                (f64.add (local.get $baseValue)
                  (f64.load (i32.add (local.get $metadata)
                    (i32.add (i32.const 72) (i32.mul (local.get $channel) (i32.const 8))))))
                (call $exp2 (f64.mul (local.get $boost) (local.get $weight))))
              (f64.load (i32.add (local.get $metadata)
                (i32.add (i32.const 96) (i32.mul (local.get $channel) (i32.const 8))))))))
          (call $gain_store_f32 (local.get $output) (local.get $x) (local.get $y) (local.get $channel) (local.get $value))
          (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
          (br_if $channels (i32.lt_u (local.get $channel) (i32.const 3))))
        (call $gain_store_f32 (local.get $output) (local.get $x) (local.get $y) (i32.const 3) (f64.const 1))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $columns (i32.lt_u (local.get $x) (i32.load offset=8 (local.get $base)))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_u (local.get $y) (i32.load offset=12 (local.get $base)))))
    (i32.const 0))

  (func $gain_order (param $a f64) (param $b f64) (param $c f64) (result i32)
    (if (f64.ge (local.get $a) (local.get $b))
      (then
        (if (f64.ge (local.get $b) (local.get $c)) (then (return (i32.const 12))))
        (if (f64.ge (local.get $a) (local.get $c)) (then (return (i32.const 21))))
        (return (i32.const 201)))
      (else
        (if (f64.ge (local.get $a) (local.get $c)) (then (return (i32.const 102))))
        (if (f64.ge (local.get $b) (local.get $c)) (then (return (i32.const 120))))
        (return (i32.const 210))))
    (i32.const 0))

  ;; Measures the generated/downsampled map against the unquantized per-pixel
  ;; logarithmic gain at one display boost. This is production verification,
  ;; not the independent test oracle.
  (func (export "gain_map_measure_generation_error")
    (param $base i32) (param $alternate i32) (param $gainImage i32)
    (param $metadata i32) (param $displayBoost f64) (param $summary i32) (result i32)
    (local $x i32) (local $y i32) (local $channel i32) (local $pixels i32)
    (local $weight f64) (local $baseValue f64) (local $alternateValue f64)
    (local $stored f64) (local $recovery f64) (local $minimum f64) (local $maximumGain f64)
    (local $logarithmicGain f64) (local $encodedGain f64)
    (local $expected f64) (local $actual f64) (local $error f64)
    (local $maximumError f64) (local $sum f64) (local $squared f64) (local $relative f64)
    (local $referenceLuminance f64) (local $actualLuminance f64)
    (local $clipped i32) (local $clippedCount i32) (local $orderCount i32)
    (call $gain_begin)
    (if (call $gain_require_initialized) (then (return (global.get $gain_error))))
    (if (call $gain_image_validate (local.get $base)) (then (return (global.get $gain_error))))
    (if (call $gain_image_validate (local.get $alternate)) (then (return (global.get $gain_error))))
    (if (call $gain_image_validate (local.get $gainImage)) (then (return (global.get $gain_error))))
    (if (call $gain_metadata_validate_internal (local.get $metadata) (i32.const 0))
      (then (return (global.get $gain_error))))
    (if (i32.eqz (call $gain_span (local.get $summary) (i32.const 40)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 5)))))
    (if (i32.or
        (i32.or (i32.gt_u (i32.load offset=20 (local.get $base)) (i32.const 2))
          (i32.gt_u (i32.load offset=24 (local.get $base)) (i32.const 1)))
        (i32.eqz (i32.and (i32.load offset=28 (local.get $base)) (i32.const 1))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_LAYOUT) (i32.const 0)))))
    (if (i32.or
        (i32.ne (i32.load offset=20 (local.get $alternate)) (i32.const 2))
        (i32.ne (i32.load offset=24 (local.get $alternate)) (i32.const 1)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_LAYOUT) (i32.const 1)))))
    (if (i32.or
        (i32.ne (i32.load offset=20 (local.get $gainImage)) (i32.const 2))
        (i32.ne (i32.load offset=24 (local.get $gainImage)) (i32.const 0)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_LAYOUT) (i32.const 2)))))
    (if (i32.or
        (i32.or
          (i32.ne (i32.load offset=8 (local.get $alternate)) (i32.load offset=8 (local.get $base)))
          (i32.ne (i32.load offset=12 (local.get $alternate)) (i32.load offset=12 (local.get $base))))
        (i32.or
          (i32.gt_u (i32.load offset=8 (local.get $gainImage)) (i32.load offset=8 (local.get $base)))
          (i32.gt_u (i32.load offset=12 (local.get $gainImage)) (i32.load offset=12 (local.get $base)))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_DIMENSIONS) (i32.const 1)))))
    (if (i32.or (i32.eqz (call $gain_finite (local.get $displayBoost)))
        (f64.le (local.get $displayBoost) (f64.const 0)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC) (i32.const 4)))))
    (local.set $weight (f64.min (f64.max
      (f64.div
        (f64.sub (call $log2 (local.get $displayBoost)) (f64.load offset=120 (local.get $metadata)))
        (f64.sub (f64.load offset=128 (local.get $metadata)) (f64.load offset=120 (local.get $metadata))))
      (f64.const 0)) (f64.const 1)))
    (local.set $pixels (i32.mul (i32.load offset=8 (local.get $base)) (i32.load offset=12 (local.get $base))))
    (loop $rows
      (local.set $x (i32.const 0))
      (loop $columns
        (call $gain_base_pixel (local.get $base) (local.get $x) (local.get $y))
        (local.set $channel (i32.const 0))
        (local.set $clipped (i32.const 0))
        (loop $channels
          (local.set $baseValue
            (f64.load (i32.add (call $VEC) (i32.mul (local.get $channel) (i32.const 8)))))
          (local.set $alternateValue (call $gain_sample (local.get $alternate)
            (local.get $x) (local.get $y) (local.get $channel)))
          (if (i32.or
              (i32.or (i32.eqz (call $gain_finite (local.get $baseValue)))
                (f64.lt (local.get $baseValue) (f64.const 0)))
              (i32.or (i32.eqz (call $gain_finite (local.get $alternateValue)))
                (f64.lt (local.get $alternateValue) (f64.const 0))))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (i32.mul
                (i32.add (i32.mul (local.get $y) (i32.load offset=8 (local.get $base))) (local.get $x))
                (i32.const 3)) (local.get $channel))))))
          (local.set $logarithmicGain
            (call $log2 (f64.div
              (f64.add (local.get $alternateValue)
                (f64.load (i32.add (local.get $metadata)
                  (i32.add (i32.const 96) (i32.mul (local.get $channel) (i32.const 8))))))
              (f64.add (local.get $baseValue)
                (f64.load (i32.add (local.get $metadata)
                  (i32.add (i32.const 72) (i32.mul (local.get $channel) (i32.const 8)))))))))
          (local.set $expected (f64.max (f64.const 0)
            (f64.sub
              (f64.mul
                (f64.add (local.get $baseValue)
                  (f64.load (i32.add (local.get $metadata)
                    (i32.add (i32.const 72) (i32.mul (local.get $channel) (i32.const 8))))))
                (call $exp2 (f64.mul (local.get $logarithmicGain) (local.get $weight))))
              (f64.load (i32.add (local.get $metadata)
                (i32.add (i32.const 96) (i32.mul (local.get $channel) (i32.const 8))))))))
          (local.set $stored (call $gain_recovery_at (local.get $gainImage)
            (i32.load offset=8 (local.get $base)) (i32.load offset=12 (local.get $base))
            (local.get $x) (local.get $y) (local.get $channel)))
          (if (i32.or
              (i32.eqz (call $gain_finite (local.get $stored)))
              (i32.or (f64.lt (local.get $stored) (f64.const 0))
                (f64.gt (local.get $stored) (f64.const 1))))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (i32.const 0x40000000)
                (i32.add (i32.mul
                  (i32.add (i32.mul (local.get $y) (i32.load offset=8 (local.get $base))) (local.get $x))
                  (i32.const 3)) (local.get $channel)))))))
          (local.set $encodedGain (f64.load (i32.add (local.get $metadata)
            (i32.add (i32.const 48) (i32.mul (local.get $channel) (i32.const 8))))))
          (local.set $recovery
            (if (result f64) (f64.eq (local.get $encodedGain) (f64.const 1))
              (then (local.get $stored))
              (else (call $pow (local.get $stored)
                (f64.div (f64.const 1) (local.get $encodedGain))))))
          (local.set $minimum (f64.load (i32.add (local.get $metadata)
            (i32.mul (local.get $channel) (i32.const 8)))))
          (local.set $maximumGain (f64.load (i32.add (local.get $metadata)
            (i32.add (i32.const 24) (i32.mul (local.get $channel) (i32.const 8))))))
          (local.set $encodedGain (f64.add (local.get $minimum)
            (f64.mul (f64.sub (local.get $maximumGain) (local.get $minimum)) (local.get $recovery))))
          (local.set $actual (f64.max (f64.const 0)
            (f64.sub
              (f64.mul
                (f64.add (local.get $baseValue)
                  (f64.load (i32.add (local.get $metadata)
                    (i32.add (i32.const 72) (i32.mul (local.get $channel) (i32.const 8))))))
                (call $exp2 (f64.mul (local.get $encodedGain) (local.get $weight))))
              (f64.load (i32.add (local.get $metadata)
                (i32.add (i32.const 96) (i32.mul (local.get $channel) (i32.const 8))))))))
          (local.set $actual (f64.promote_f32 (f32.demote_f64 (local.get $actual))))
          (if (i32.or (i32.eqz (call $gain_finite (local.get $expected)))
              (i32.eqz (call $gain_finite (local.get $actual))))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (i32.mul
                (i32.add (i32.mul (local.get $y) (i32.load offset=8 (local.get $base))) (local.get $x))
                (i32.const 3)) (local.get $channel))))))
          (f64.store (i32.add (i32.const 39000) (i32.mul (local.get $channel) (i32.const 8)))
            (local.get $expected))
          (f64.store (i32.add (i32.const 39024) (i32.mul (local.get $channel) (i32.const 8)))
            (local.get $actual))
          (local.set $error (f64.abs (f64.sub (local.get $expected) (local.get $actual))))
          (local.set $maximumError (f64.max (local.get $maximumError) (local.get $error)))
          (local.set $sum (f64.add (local.get $sum) (local.get $error)))
          (local.set $squared (f64.add (local.get $squared) (f64.mul (local.get $error) (local.get $error))))
          (if (i32.and (f64.eq (local.get $actual) (f64.const 0))
              (f64.gt (local.get $expected) (f64.const 0)))
            (then (local.set $clipped (i32.const 1))))
          (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
          (br_if $channels (i32.lt_u (local.get $channel) (i32.const 3))))
        (local.set $clippedCount (i32.add (local.get $clippedCount) (local.get $clipped)))
        (local.set $referenceLuminance (f64.add
          (f64.add
            (f64.mul (f64.load (i32.const 39000)) (f64.const 0.2627))
            (f64.mul (f64.load (i32.const 39008)) (f64.const 0.6780)))
          (f64.mul (f64.load (i32.const 39016)) (f64.const 0.0593))))
        (local.set $actualLuminance (f64.add
          (f64.add
            (f64.mul (f64.load (i32.const 39024)) (f64.const 0.2627))
            (f64.mul (f64.load (i32.const 39032)) (f64.const 0.6780)))
          (f64.mul (f64.load (i32.const 39040)) (f64.const 0.0593))))
        (local.set $relative (f64.add (local.get $relative)
          (f64.div (f64.abs (f64.sub (local.get $referenceLuminance) (local.get $actualLuminance)))
            (f64.max (local.get $referenceLuminance) (f64.const 0.0000152587890625)))))
        (if (f64.gt (f64.max
            (f64.max (f64.load (i32.const 39000)) (f64.load (i32.const 39008)))
            (f64.load (i32.const 39016))) (f64.const 1))
          (then
            (if (i32.ne
                (call $gain_order (f64.load (i32.const 39000))
                  (f64.load (i32.const 39008)) (f64.load (i32.const 39016)))
                (call $gain_order (f64.load (i32.const 39024))
                  (f64.load (i32.const 39032)) (f64.load (i32.const 39040))))
              (then (local.set $orderCount (i32.add (local.get $orderCount) (i32.const 1)))))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $columns (i32.lt_u (local.get $x) (i32.load offset=8 (local.get $base)))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_u (local.get $y) (i32.load offset=12 (local.get $base)))))
    (f64.store (local.get $summary) (local.get $maximumError))
    (f64.store offset=8 (local.get $summary)
      (f64.div (local.get $sum) (f64.convert_i32_u (i32.mul (local.get $pixels) (i32.const 3)))))
    (f64.store offset=16 (local.get $summary) (f64.sqrt
      (f64.div (local.get $squared) (f64.convert_i32_u (i32.mul (local.get $pixels) (i32.const 3))))))
    (f64.store offset=24 (local.get $summary)
      (f64.div (local.get $relative) (f64.convert_i32_u (local.get $pixels))))
    (i32.store offset=32 (local.get $summary) (local.get $clippedCount))
    (i32.store offset=36 (local.get $summary) (local.get $orderCount))
    (i32.const 0))

  (func (export "gain_map_measure_error")
    (param $reference i32) (param $reconstructed i32) (param $summary i32) (result i32)
    (local $x i32) (local $y i32) (local $channel i32) (local $pixels i32)
    (local $rv f64) (local $ov f64) (local $error f64) (local $maximum f64)
    (local $sum f64) (local $squared f64) (local $relative f64)
    (local $rl f64) (local $ol f64) (local $clipped i32) (local $clippedCount i32) (local $orderCount i32)
    (call $gain_begin)
    (if (call $gain_require_initialized) (then (return (global.get $gain_error))))
    (if (call $gain_image_validate (local.get $reference)) (then (return (global.get $gain_error))))
    (if (call $gain_image_validate (local.get $reconstructed)) (then (return (global.get $gain_error))))
    (if (i32.eqz (call $gain_span (local.get $summary) (i32.const 40)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 2)))))
    (if (i32.or
        (i32.or (i32.ne (i32.load offset=20 (local.get $reference)) (i32.const 2))
          (i32.ne (i32.load offset=24 (local.get $reference)) (i32.const 1)))
        (i32.or (i32.ne (i32.load offset=20 (local.get $reconstructed)) (i32.const 2))
          (i32.ne (i32.load offset=24 (local.get $reconstructed)) (i32.const 1))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_LAYOUT) (i32.const 0)))))
    (if (i32.or
        (i32.ne (i32.load offset=8 (local.get $reference)) (i32.load offset=8 (local.get $reconstructed)))
        (i32.ne (i32.load offset=12 (local.get $reference)) (i32.load offset=12 (local.get $reconstructed))))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_DIMENSIONS) (i32.const 1)))))
    (local.set $pixels (i32.mul (i32.load offset=8 (local.get $reference)) (i32.load offset=12 (local.get $reference))))
    (loop $rows
      (local.set $x (i32.const 0))
      (loop $columns
        (local.set $channel (i32.const 0))
        (local.set $clipped (i32.const 0))
        (loop $channels
          (local.set $rv (call $gain_sample (local.get $reference) (local.get $x) (local.get $y) (local.get $channel)))
          (local.set $ov (call $gain_sample (local.get $reconstructed) (local.get $x) (local.get $y) (local.get $channel)))
          (if (i32.or (i32.eqz (call $gain_finite (local.get $rv))) (f64.lt (local.get $rv) (f64.const 0)))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (i32.mul
                (i32.add (i32.mul (local.get $y) (i32.load offset=8 (local.get $reference))) (local.get $x))
                (i32.const 3)) (local.get $channel))))))
          (if (i32.or (i32.eqz (call $gain_finite (local.get $ov))) (f64.lt (local.get $ov) (f64.const 0)))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_NUMERIC)
              (i32.add (i32.const 0x40000000)
                (i32.add (i32.mul
                  (i32.add (i32.mul (local.get $y) (i32.load offset=8 (local.get $reference))) (local.get $x))
                  (i32.const 3)) (local.get $channel)))))))
          (local.set $error (f64.abs (f64.sub (local.get $rv) (local.get $ov))))
          (local.set $maximum (f64.max (local.get $maximum) (local.get $error)))
          (local.set $sum (f64.add (local.get $sum) (local.get $error)))
          (local.set $squared (f64.add (local.get $squared) (f64.mul (local.get $error) (local.get $error))))
          (if (i32.and (f64.eq (local.get $ov) (f64.const 0)) (f64.gt (local.get $rv) (f64.const 0)))
            (then (local.set $clipped (i32.const 1))))
          (local.set $channel (i32.add (local.get $channel) (i32.const 1)))
          (br_if $channels (i32.lt_u (local.get $channel) (i32.const 3))))
        (local.set $clippedCount (i32.add (local.get $clippedCount) (local.get $clipped)))
        (local.set $rl (f64.add
          (f64.add
            (f64.mul (call $gain_sample (local.get $reference) (local.get $x) (local.get $y) (i32.const 0)) (f64.const 0.2627))
            (f64.mul (call $gain_sample (local.get $reference) (local.get $x) (local.get $y) (i32.const 1)) (f64.const 0.6780)))
          (f64.mul (call $gain_sample (local.get $reference) (local.get $x) (local.get $y) (i32.const 2)) (f64.const 0.0593))))
        (local.set $ol (f64.add
          (f64.add
            (f64.mul (call $gain_sample (local.get $reconstructed) (local.get $x) (local.get $y) (i32.const 0)) (f64.const 0.2627))
            (f64.mul (call $gain_sample (local.get $reconstructed) (local.get $x) (local.get $y) (i32.const 1)) (f64.const 0.6780)))
          (f64.mul (call $gain_sample (local.get $reconstructed) (local.get $x) (local.get $y) (i32.const 2)) (f64.const 0.0593))))
        (local.set $relative (f64.add (local.get $relative)
          (f64.div (f64.abs (f64.sub (local.get $rl) (local.get $ol)))
            (f64.max (local.get $rl) (f64.const 0.0000152587890625)))))
        (if (f64.gt (f64.max
            (f64.max (call $gain_sample (local.get $reference) (local.get $x) (local.get $y) (i32.const 0))
              (call $gain_sample (local.get $reference) (local.get $x) (local.get $y) (i32.const 1)))
            (call $gain_sample (local.get $reference) (local.get $x) (local.get $y) (i32.const 2))) (f64.const 1))
          (then
            (if (i32.ne
                (call $gain_order
                  (call $gain_sample (local.get $reference) (local.get $x) (local.get $y) (i32.const 0))
                  (call $gain_sample (local.get $reference) (local.get $x) (local.get $y) (i32.const 1))
                  (call $gain_sample (local.get $reference) (local.get $x) (local.get $y) (i32.const 2)))
                (call $gain_order
                  (call $gain_sample (local.get $reconstructed) (local.get $x) (local.get $y) (i32.const 0))
                  (call $gain_sample (local.get $reconstructed) (local.get $x) (local.get $y) (i32.const 1))
                  (call $gain_sample (local.get $reconstructed) (local.get $x) (local.get $y) (i32.const 2))))
              (then (local.set $orderCount (i32.add (local.get $orderCount) (i32.const 1)))))))
        (local.set $x (i32.add (local.get $x) (i32.const 1)))
        (br_if $columns (i32.lt_u (local.get $x) (i32.load offset=8 (local.get $reference)))))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br_if $rows (i32.lt_u (local.get $y) (i32.load offset=12 (local.get $reference)))))
    (f64.store (local.get $summary) (local.get $maximum))
    (f64.store offset=8 (local.get $summary) (f64.div (local.get $sum) (f64.convert_i32_u (i32.mul (local.get $pixels) (i32.const 3)))))
    (f64.store offset=16 (local.get $summary) (f64.sqrt
      (f64.div (local.get $squared) (f64.convert_i32_u (i32.mul (local.get $pixels) (i32.const 3))))))
    (f64.store offset=24 (local.get $summary) (f64.div (local.get $relative) (f64.convert_i32_u (local.get $pixels))))
    (i32.store offset=32 (local.get $summary) (local.get $clippedCount))
    (i32.store offset=36 (local.get $summary) (local.get $orderCount))
    (i32.const 0))
