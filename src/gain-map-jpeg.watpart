  ;; Bounded JPEG traversal, MPF inspection and adaptive package assembly.
  ;; Internal scan records at 40 KiB are shared scratch and calls serialize.

  (func $gain_match (param $p i32) (param $q i32) (param $length i32) (result i32)
    (local $i i32)
    (loop $bytes
      (if (i32.ne (i32.load8_u (i32.add (local.get $p) (local.get $i)))
          (i32.load8_u (i32.add (local.get $q) (local.get $i))))
        (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $bytes (i32.lt_u (local.get $i) (local.get $length))))
    (i32.const 1))
  (func $gain_sof_marker (param $marker i32) (result i32)
    (i32.or
      (i32.or
        (i32.or (i32.eq (local.get $marker) (i32.const 0xc0)) (i32.eq (local.get $marker) (i32.const 0xc1)))
        (i32.or (i32.eq (local.get $marker) (i32.const 0xc2)) (i32.eq (local.get $marker) (i32.const 0xc3))))
      (i32.or
        (i32.or
          (i32.or (i32.eq (local.get $marker) (i32.const 0xc5)) (i32.eq (local.get $marker) (i32.const 0xc6)))
          (i32.or (i32.eq (local.get $marker) (i32.const 0xc7)) (i32.eq (local.get $marker) (i32.const 0xc9))))
        (i32.or
          (i32.or (i32.eq (local.get $marker) (i32.const 0xca)) (i32.eq (local.get $marker) (i32.const 0xcb)))
          (i32.or
            (i32.or (i32.eq (local.get $marker) (i32.const 0xcd)) (i32.eq (local.get $marker) (i32.const 0xce)))
            (i32.eq (local.get $marker) (i32.const 0xcf)))))))

  ;; Scan result (72 bytes): end,length,width,height,channels,SOF count,
  ;; ISO count/pointer/length, HDR-XMP count/text pointer/length,
  ;; MPF count/pointer/length,SOS marker offset,prefix end.
  (func $gain_scan_jpeg (param $bytes i32) (param $length i32) (param $startOffset i32) (param $result i32) (result i32)
    (local $start i32) (local $end i32) (local $offset i32) (local $markerStart i32)
    (local $marker i32) (local $segmentLength i32) (local $payload i32) (local $payloadLength i32)
    (local $scanMarker i32)
    (memory.fill (local.get $result) (i32.const 0) (i32.const 72))
    (if (i32.gt_u (i32.add (local.get $startOffset) (i32.const 2)) (local.get $length))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_JPEG) (local.get $startOffset)))))
    (local.set $start (i32.add (local.get $bytes) (local.get $startOffset)))
    (local.set $end (i32.add (local.get $bytes) (local.get $length)))
    (if (i32.or (i32.ne (i32.load8_u (local.get $start)) (i32.const 0xff))
        (i32.ne (i32.load8_u offset=1 (local.get $start)) (i32.const 0xd8)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_JPEG) (local.get $startOffset)))))
    (local.set $offset (i32.add (local.get $start) (i32.const 2)))
    (loop $segments
      (if (i32.ge_u (local.get $offset) (local.get $end))
        (then (return (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED)
          (i32.sub (local.get $offset) (local.get $bytes))))))
      (if (i32.ne (i32.load8_u (local.get $offset)) (i32.const 0xff))
        (then (return (call $gain_fail (global.get $GAIN_ERROR_JPEG)
          (i32.sub (local.get $offset) (local.get $bytes))))))
      (local.set $markerStart (local.get $offset))
      (loop $fill
        (if (i32.ge_u (local.get $offset) (local.get $end))
          (then (return (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED)
            (i32.sub (local.get $offset) (local.get $bytes))))))
        (if (i32.eq (i32.load8_u (local.get $offset)) (i32.const 0xff))
          (then (local.set $offset (i32.add (local.get $offset) (i32.const 1))) (br $fill))))
      (local.set $marker (i32.load8_u (local.get $offset)))
      (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
      (if (i32.eq (local.get $marker) (i32.const 0xd9))
        (then
          (i32.store (local.get $result) (local.get $offset))
          (i32.store offset=4 (local.get $result) (i32.sub (local.get $offset) (local.get $start)))
          (if (i32.ne (i32.load offset=20 (local.get $result)) (i32.const 1))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_JPEG)
              (i32.sub (local.get $markerStart) (local.get $bytes))))))
          (return (i32.const 0))))
      (if (i32.eqz (local.get $marker))
        (then (return (call $gain_fail (global.get $GAIN_ERROR_JPEG)
          (i32.sub (local.get $markerStart) (local.get $bytes))))))
      (if (i32.or (i32.and (i32.ge_u (local.get $marker) (i32.const 0xd0))
            (i32.le_u (local.get $marker) (i32.const 0xd7)))
          (i32.eq (local.get $marker) (i32.const 1)))
        (then (br $segments)))
      (if (i32.gt_u (i32.add (local.get $offset) (i32.const 2)) (local.get $end))
        (then (return (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED)
          (i32.sub (local.get $markerStart) (local.get $bytes))))))
      (local.set $segmentLength (call $gain_read_u16be (local.get $offset)))
      (if (i32.lt_u (local.get $segmentLength) (i32.const 2))
        (then (return (call $gain_fail (global.get $GAIN_ERROR_JPEG)
          (i32.sub (local.get $markerStart) (local.get $bytes))))))
      (local.set $payload (i32.add (local.get $offset) (i32.const 2)))
      (local.set $payloadLength (i32.sub (local.get $segmentLength) (i32.const 2)))
      (if (i32.gt_u (i32.add (local.get $payload) (local.get $payloadLength)) (local.get $end))
        (then (return (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED)
          (i32.sub (local.get $markerStart) (local.get $bytes))))))
      (if (call $gain_sof_marker (local.get $marker))
        (then
          (i32.store offset=20 (local.get $result)
            (i32.add (i32.load offset=20 (local.get $result)) (i32.const 1)))
          (if (i32.lt_u (local.get $payloadLength) (i32.const 6))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED)
              (i32.sub (local.get $payload) (local.get $bytes))))))
          (i32.store offset=8 (local.get $result) (call $gain_read_u16be (i32.add (local.get $payload) (i32.const 3))))
          (i32.store offset=12 (local.get $result) (call $gain_read_u16be (i32.add (local.get $payload) (i32.const 1))))
          (i32.store offset=16 (local.get $result) (i32.load8_u offset=5 (local.get $payload)))
          (if (i32.or
              (i32.or (i32.eqz (i32.load offset=8 (local.get $result)))
                (i32.eqz (i32.load offset=12 (local.get $result))))
              (i32.eqz (i32.or
                (i32.eq (i32.load offset=16 (local.get $result)) (i32.const 1))
                (i32.or (i32.eq (i32.load offset=16 (local.get $result)) (i32.const 3))
                  (i32.eq (i32.load offset=16 (local.get $result)) (i32.const 4))))))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_UNSUPPORTED)
              (i32.sub (local.get $payload) (local.get $bytes))))))))
      (if (i32.and (i32.eq (local.get $marker) (i32.const 0xe2))
          (i32.and (i32.ge_u (local.get $payloadLength) (i32.const 28))
            (call $gain_match (local.get $payload) (i32.const 35040) (i32.const 28))))
        (then
          (i32.store offset=24 (local.get $result)
            (i32.add (i32.load offset=24 (local.get $result)) (i32.const 1)))
          (i32.store offset=28 (local.get $result) (i32.add (local.get $payload) (i32.const 28)))
          (i32.store offset=32 (local.get $result) (i32.sub (local.get $payloadLength) (i32.const 28)))))
      (if (i32.and (i32.eq (local.get $marker) (i32.const 0xe1))
          (i32.and (i32.ge_u (local.get $payloadLength) (i32.const 29))
            (call $gain_match (local.get $payload) (i32.const 35000) (i32.const 29))))
        (then
          (if (i32.ge_s (call $gain_find (i32.add (local.get $payload) (i32.const 29))
              (i32.sub (local.get $payloadLength) (i32.const 29)) (i32.const 35080) (i32.const 37) (i32.const 0)) (i32.const 0))
            (then
              (i32.store offset=36 (local.get $result)
                (i32.add (i32.load offset=36 (local.get $result)) (i32.const 1)))
              (i32.store offset=40 (local.get $result) (i32.add (local.get $payload) (i32.const 29)))
              (i32.store offset=44 (local.get $result) (i32.sub (local.get $payloadLength) (i32.const 29)))))))
      (if (i32.and (i32.eq (local.get $marker) (i32.const 0xe2))
          (i32.and (i32.ge_u (local.get $payloadLength) (i32.const 4))
            (i32.and
              (i32.eq (i32.load8_u (local.get $payload)) (i32.const 0x4d))
              (i32.and
                (i32.eq (i32.load8_u offset=1 (local.get $payload)) (i32.const 0x50))
                (i32.and (i32.eq (i32.load8_u offset=2 (local.get $payload)) (i32.const 0x46))
                  (i32.eqz (i32.load8_u offset=3 (local.get $payload))))))))
        (then
          (i32.store offset=48 (local.get $result)
            (i32.add (i32.load offset=48 (local.get $result)) (i32.const 1)))
          (i32.store offset=52 (local.get $result) (local.get $payload))
          (i32.store offset=56 (local.get $result) (local.get $payloadLength))))
      (if (i32.and (i32.eqz (i32.load offset=68 (local.get $result)))
          (i32.eq (local.get $markerStart) (i32.add (local.get $start) (i32.const 2))))
        (then
          (if (i32.eq (local.get $marker) (i32.const 0xe0))
            (then (i32.store offset=68 (local.get $result)
              (i32.add (local.get $payload) (local.get $payloadLength))))
            (else (i32.store offset=68 (local.get $result) (i32.add (local.get $start) (i32.const 2)))))))
      (local.set $offset (i32.add (local.get $payload) (local.get $payloadLength)))
      (if (i32.ne (local.get $marker) (i32.const 0xda)) (then (br $segments)))
      (if (i32.eqz (i32.load offset=60 (local.get $result)))
        (then (i32.store offset=60 (local.get $result) (local.get $markerStart))))
      (loop $entropy
        (if (i32.ge_u (local.get $offset) (local.get $end))
          (then (return (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED)
            (i32.sub (local.get $offset) (local.get $bytes))))))
        (if (i32.ne (i32.load8_u (local.get $offset)) (i32.const 0xff))
          (then (local.set $offset (i32.add (local.get $offset) (i32.const 1))) (br $entropy)))
        (local.set $markerStart (local.get $offset))
        (loop $scanFill
          (if (i32.ge_u (local.get $offset) (local.get $end))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED)
              (i32.sub (local.get $offset) (local.get $bytes))))))
          (if (i32.eq (i32.load8_u (local.get $offset)) (i32.const 0xff))
            (then (local.set $offset (i32.add (local.get $offset) (i32.const 1))) (br $scanFill))))
        (local.set $scanMarker (i32.load8_u (local.get $offset)))
        (local.set $offset (i32.add (local.get $offset) (i32.const 1)))
        (if (i32.or (i32.eqz (local.get $scanMarker))
            (i32.and (i32.ge_u (local.get $scanMarker) (i32.const 0xd0))
              (i32.le_u (local.get $scanMarker) (i32.const 0xd7))))
          (then (br $entropy)))
        (if (i32.eq (local.get $scanMarker) (i32.const 0xd9))
          (then
            (i32.store (local.get $result) (local.get $offset))
            (i32.store offset=4 (local.get $result) (i32.sub (local.get $offset) (local.get $start)))
            (if (i32.ne (i32.load offset=20 (local.get $result)) (i32.const 1))
              (then (return (call $gain_fail (global.get $GAIN_ERROR_JPEG)
                (i32.sub (local.get $markerStart) (local.get $bytes))))))
            (return (i32.const 0))))
        (local.set $offset (local.get $markerStart))
        (br $segments)))
    (call $gain_fail (global.get $GAIN_ERROR_JPEG) (local.get $startOffset)))

  (func $gain_tiff_u16 (param $base i32) (param $length i32) (param $position i32) (param $little i32) (result i32)
    (if (i32.gt_u (i32.add (local.get $position) (i32.const 2)) (local.get $length))
      (then
        (drop (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED) (local.get $position)))
        (return (i32.const 0))))
    (if (result i32) (local.get $little)
      (then (i32.or (i32.load8_u (i32.add (local.get $base) (local.get $position)))
        (i32.shl (i32.load8_u (i32.add (local.get $base) (i32.add (local.get $position) (i32.const 1)))) (i32.const 8))))
      (else (call $gain_read_u16be (i32.add (local.get $base) (local.get $position))))))
  (func $gain_tiff_u32 (param $base i32) (param $length i32) (param $position i32) (param $little i32) (result i32)
    (if (i32.gt_u (i32.add (local.get $position) (i32.const 4)) (local.get $length))
      (then
        (drop (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED) (local.get $position)))
        (return (i32.const 0))))
    (if (result i32) (local.get $little)
      (then
        (i32.or
          (i32.or (i32.load8_u (i32.add (local.get $base) (local.get $position)))
            (i32.shl (i32.load8_u (i32.add (local.get $base) (i32.add (local.get $position) (i32.const 1)))) (i32.const 8)))
          (i32.or
            (i32.shl (i32.load8_u (i32.add (local.get $base) (i32.add (local.get $position) (i32.const 2)))) (i32.const 16))
            (i32.shl (i32.load8_u (i32.add (local.get $base) (i32.add (local.get $position) (i32.const 3)))) (i32.const 24)))))
      (else (call $gain_read_u32be (i32.add (local.get $base) (local.get $position))))))

  (func $gain_parse_mpf (param $file i32) (param $fileLength i32) (param $primaryStart i32)
    (param $payload i32) (param $payloadLength i32) (param $entries i32) (param $capacity i32) (result i32)
    (local $tiff i32) (local $length i32) (local $little i32) (local $directory i32) (local $tagCount i32)
    (local $i i32) (local $tagOffset i32) (local $tag i32) (local $type i32) (local $count i32) (local $value i32)
    (local $seen i32) (local $imageCount i32) (local $entriesOffset i32) (local $entry i32)
    (if (i32.lt_u (local.get $payloadLength) (i32.const 12))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED)
        (i32.sub (local.get $payload) (local.get $file))))))
    (local.set $tiff (i32.add (local.get $payload) (i32.const 4)))
    (local.set $length (i32.sub (local.get $payloadLength) (i32.const 4)))
    (if (i32.and (i32.eq (i32.load8_u (local.get $tiff)) (i32.const 0x49))
        (i32.eq (i32.load8_u offset=1 (local.get $tiff)) (i32.const 0x49)))
      (then (local.set $little (i32.const 1)))
      (else
        (if (i32.eqz (i32.and (i32.eq (i32.load8_u (local.get $tiff)) (i32.const 0x4d))
            (i32.eq (i32.load8_u offset=1 (local.get $tiff)) (i32.const 0x4d))))
          (then (return (call $gain_fail (global.get $GAIN_ERROR_MPF)
            (i32.sub (local.get $tiff) (local.get $file))))))))
    (if (i32.ne (call $gain_tiff_u16 (local.get $tiff) (local.get $length) (i32.const 2) (local.get $little)) (i32.const 42))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_MPF)
        (i32.sub (local.get $tiff) (local.get $file))))))
    (local.set $directory (call $gain_tiff_u32 (local.get $tiff) (local.get $length) (i32.const 4) (local.get $little)))
    (if (global.get $gain_error) (then (return (global.get $gain_error))))
    (local.set $tagCount (call $gain_tiff_u16 (local.get $tiff) (local.get $length) (local.get $directory) (local.get $little)))
    (if (global.get $gain_error) (then (return (global.get $gain_error))))
    (if (i64.gt_u
        (i64.add (i64.extend_i32_u (local.get $directory))
          (i64.add (i64.const 2) (i64.mul (i64.extend_i32_u (local.get $tagCount)) (i64.const 12))))
        (i64.extend_i32_u (local.get $length)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED) (local.get $directory)))))
    (loop $tags
      (local.set $tagOffset (i32.add (local.get $directory)
        (i32.add (i32.const 2) (i32.mul (local.get $i) (i32.const 12)))))
      (local.set $tag (call $gain_tiff_u16 (local.get $tiff) (local.get $length) (local.get $tagOffset) (local.get $little)))
      (local.set $type (call $gain_tiff_u16 (local.get $tiff) (local.get $length) (i32.add (local.get $tagOffset) (i32.const 2)) (local.get $little)))
      (local.set $count (call $gain_tiff_u32 (local.get $tiff) (local.get $length) (i32.add (local.get $tagOffset) (i32.const 4)) (local.get $little)))
      (local.set $value (call $gain_tiff_u32 (local.get $tiff) (local.get $length) (i32.add (local.get $tagOffset) (i32.const 8)) (local.get $little)))
      (if (i32.eq (local.get $tag) (i32.const 0xb000))
        (then
          (if (i32.and (local.get $seen) (i32.const 1)) (then (return (call $gain_fail (global.get $GAIN_ERROR_DUPLICATE) (local.get $tagOffset)))))
          (local.set $seen (i32.or (local.get $seen) (i32.const 1)))
          (if (i32.or (i32.ne (local.get $type) (i32.const 7)) (i32.ne (local.get $count) (i32.const 4)))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_MPF) (local.get $tagOffset)))))
          (if (i32.eqz (i32.and
              (i32.and (i32.eq (i32.load8_u (i32.add (local.get $tiff) (i32.add (local.get $tagOffset) (i32.const 8)))) (i32.const 0x30))
                (i32.eq (i32.load8_u (i32.add (local.get $tiff) (i32.add (local.get $tagOffset) (i32.const 9)))) (i32.const 0x31)))
              (i32.and (i32.eq (i32.load8_u (i32.add (local.get $tiff) (i32.add (local.get $tagOffset) (i32.const 10)))) (i32.const 0x30))
                (i32.eq (i32.load8_u (i32.add (local.get $tiff) (i32.add (local.get $tagOffset) (i32.const 11)))) (i32.const 0x30)))))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_MPF) (local.get $tagOffset)))))))
      (if (i32.eq (local.get $tag) (i32.const 0xb001))
        (then
          (if (i32.and (local.get $seen) (i32.const 2)) (then (return (call $gain_fail (global.get $GAIN_ERROR_DUPLICATE) (local.get $tagOffset)))))
          (local.set $seen (i32.or (local.get $seen) (i32.const 2)))
          (if (i32.or (i32.ne (local.get $type) (i32.const 4))
              (i32.or (i32.ne (local.get $count) (i32.const 1)) (i32.eqz (local.get $value))))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_MPF) (local.get $tagOffset)))))
          (local.set $imageCount (local.get $value))))
      (if (i32.eq (local.get $tag) (i32.const 0xb002))
        (then
          (if (i32.and (local.get $seen) (i32.const 4)) (then (return (call $gain_fail (global.get $GAIN_ERROR_DUPLICATE) (local.get $tagOffset)))))
          (local.set $seen (i32.or (local.get $seen) (i32.const 4)))
          (if (i32.ne (local.get $type) (i32.const 7))
            (then (return (call $gain_fail (global.get $GAIN_ERROR_MPF) (local.get $tagOffset)))))
          (local.set $entriesOffset (local.get $value))
          ;; Defer count comparison until image count is known.
          (i32.store (i32.const 40960) (local.get $count))))
      (if (i32.eqz (i32.or (i32.eq (local.get $tag) (i32.const 0xb000))
          (i32.or (i32.eq (local.get $tag) (i32.const 0xb001)) (i32.eq (local.get $tag) (i32.const 0xb002)))))
        (then (return (call $gain_fail (global.get $GAIN_ERROR_MPF) (local.get $tagOffset)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $tags (i32.lt_u (local.get $i) (local.get $tagCount))))
    (if (i32.ne (local.get $seen) (i32.const 7))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_MPF) (local.get $seen)))))
    (if (i64.ne (i64.extend_i32_u (i32.load (i32.const 40960)))
        (i64.mul (i64.extend_i32_u (local.get $imageCount)) (i64.const 16)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_MPF) (local.get $entriesOffset)))))
    (if (i32.lt_u (local.get $capacity) (local.get $imageCount))
      (then (global.set $gain_required (i32.mul (local.get $imageCount) (i32.const 16)))
        (return (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (local.get $imageCount)))))
    (if (i64.gt_u
        (i64.add (i64.extend_i32_u (local.get $entriesOffset))
          (i64.mul (i64.extend_i32_u (local.get $imageCount)) (i64.const 16)))
        (i64.extend_i32_u (local.get $length)))
      (then (return (call $gain_fail (global.get $GAIN_ERROR_TRUNCATED) (local.get $entriesOffset)))))
    (local.set $i (i32.const 0))
    (loop $entriesLoop
      (local.set $entry (i32.add (local.get $entriesOffset) (i32.mul (local.get $i) (i32.const 16))))
