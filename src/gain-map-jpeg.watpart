    (if (i32.or (i32.eqz (call $gain_span (local.get $base) (local.get $baseLength)))
        (i32.eqz (call $gain_span (local.get $gain) (local.get $gainLength))))
      (then (drop (call $gain_fail (global.get $GAIN_ERROR_SPAN) (i32.const 0))) (return (i32.const 0))))
    (if (call $gain_metadata_validate_internal (local.get $metadata) (i32.const 0)) (then (return (i32.const 0))))
    (if (call $gain_scan_jpeg (local.get $base) (local.get $baseLength) (i32.const 0) (i32.const 40000))
      (then (return (i32.const 0))))
    (if (i32.ne (i32.load (i32.const 40000)) (i32.add (local.get $base) (local.get $baseLength)))
      (then (drop (call $gain_fail (global.get $GAIN_ERROR_TRAILING) (i32.const 0))) (return (i32.const 0))))
    (if (call $gain_scan_jpeg (local.get $gain) (local.get $gainLength) (i32.const 0) (i32.const 40100))
      (then (return (i32.const 0))))
    (if (i32.ne (i32.load (i32.const 40100)) (i32.add (local.get $gain) (local.get $gainLength)))
      (then (drop (call $gain_fail (global.get $GAIN_ERROR_TRAILING) (i32.const 1))) (return (i32.const 0))))
    ;; ISO is authoritative; XMP serializes its round-tripped rational values.
    (local.set $isoLength (call $gain_iso_encode_bridge (local.get $metadata) (i32.const 44000) (i32.const 256)))
    (if (i32.eqz (local.get $isoLength)) (then (return (i32.const 0))))
    (if (call $gain_iso_decode_bridge (i32.const 44000) (local.get $isoLength) (i32.const 44256))
      (then (return (i32.const 0))))
    (local.set $secondaryXmpLength (call $gain_xmp_secondary_internal (i32.const 44256) (i32.const 45000) (i32.const 4096)))
    (if (i32.lt_s (local.get $secondaryXmpLength) (i32.const 0))
      (then (drop (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4))) (return (i32.const 0))))
    (local.set $secondaryLength
      (i32.add (local.get $gainLength)
        (i32.add (i32.add (i32.const 32) (local.get $isoLength))
          (i32.add (i32.const 33) (local.get $secondaryXmpLength)))))
    (local.set $primaryXmpLength (call $gain_xmp_primary_internal (local.get $secondaryLength) (i32.const 50000) (i32.const 1024)))
    (if (i32.lt_s (local.get $primaryXmpLength) (i32.const 0))
      (then (drop (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 4))) (return (i32.const 0))))
    (local.set $primaryLength
      (i32.add (local.get $baseLength)
        (i32.add (i32.add (i32.const 33) (local.get $primaryXmpLength)) (i32.const 126))))
    (local.set $total (i32.add (local.get $primaryLength) (local.get $secondaryLength)))
    (global.set $gain_required (local.get $total))
    (if (i32.or
        (i32.or (i32.lt_u (local.get $capacity) (local.get $total))
          (i32.eqz (call $gain_span (local.get $output) (local.get $total))))
        (i32.or (i32.eqz (call $gain_nonoverlap (local.get $output) (local.get $total) (local.get $base) (local.get $baseLength)))
          (i32.eqz (call $gain_nonoverlap (local.get $output) (local.get $total) (local.get $gain) (local.get $gainLength)))))
      (then (drop (call $gain_fail (global.get $GAIN_ERROR_CAPACITY) (i32.const 6))) (return (i32.const 0))))
    ;; Primary: SOI, XMP APP1, ISO APP2 version, MPF APP2, original remainder.
    (memory.copy (local.get $output) (local.get $base) (i32.const 2))
    (local.set $position (i32.const 2))
    (i32.store8 (i32.add (local.get $output) (local.get $position)) (i32.const 0xff))
    (i32.store8 (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 1))) (i32.const 0xe1))
    (call $gain_write_u16be (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 2)))
      (i32.add (local.get $primaryXmpLength) (i32.const 31)))
    (memory.copy (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 4))) (i32.const 35000) (i32.const 29))
    (memory.copy (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 33))) (i32.const 50000) (local.get $primaryXmpLength))
    (local.set $position (i32.add (local.get $position) (i32.add (i32.const 33) (local.get $primaryXmpLength))))
    (i32.store8 (i32.add (local.get $output) (local.get $position)) (i32.const 0xff))
    (i32.store8 (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 1))) (i32.const 0xe2))
    (call $gain_write_u16be (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 2))) (i32.const 34))
    (memory.copy (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 4))) (i32.const 35040) (i32.const 28))
    (i32.store (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 32))) (i32.const 0))
    (local.set $position (i32.add (local.get $position) (i32.const 36)))
    (local.set $mpfMarkerOffset (local.get $position))
    (local.set $secondaryOffset (i32.sub (local.get $primaryLength) (i32.add (local.get $mpfMarkerOffset) (i32.const 8))))
    (call $gain_write_mpf_payload (i32.const 54000) (local.get $primaryLength) (local.get $secondaryLength) (local.get $secondaryOffset))
    (i32.store8 (i32.add (local.get $output) (local.get $position)) (i32.const 0xff))
    (i32.store8 (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 1))) (i32.const 0xe2))
    (call $gain_write_u16be (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 2))) (i32.const 88))
    (memory.copy (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 4))) (i32.const 54000) (i32.const 86))
    (local.set $position (i32.add (local.get $position) (i32.const 90)))
    (memory.copy (i32.add (local.get $output) (local.get $position)) (i32.add (local.get $base) (i32.const 2))
      (i32.sub (local.get $baseLength) (i32.const 2)))
    (local.set $position (local.get $primaryLength))
    ;; Auxiliary: SOI, ISO APP2, XMP APP1, original remainder.
    (memory.copy (i32.add (local.get $output) (local.get $position)) (local.get $gain) (i32.const 2))
    (local.set $position (i32.add (local.get $position) (i32.const 2)))
    (i32.store8 (i32.add (local.get $output) (local.get $position)) (i32.const 0xff))
    (i32.store8 (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 1))) (i32.const 0xe2))
    (call $gain_write_u16be (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 2)))
      (i32.add (local.get $isoLength) (i32.const 30)))
    (memory.copy (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 4))) (i32.const 35040) (i32.const 28))
    (memory.copy (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 32))) (i32.const 44000) (local.get $isoLength))
    (local.set $position (i32.add (local.get $position) (i32.add (i32.const 32) (local.get $isoLength))))
    (i32.store8 (i32.add (local.get $output) (local.get $position)) (i32.const 0xff))
    (i32.store8 (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 1))) (i32.const 0xe1))
    (call $gain_write_u16be (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 2)))
      (i32.add (local.get $secondaryXmpLength) (i32.const 31)))
    (memory.copy (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 4))) (i32.const 35000) (i32.const 29))
    (memory.copy (i32.add (local.get $output) (i32.add (local.get $position) (i32.const 33))) (i32.const 45000) (local.get $secondaryXmpLength))
    (local.set $position (i32.add (local.get $position) (i32.add (i32.const 33) (local.get $secondaryXmpLength))))
    (memory.copy (i32.add (local.get $output) (local.get $position)) (i32.add (local.get $gain) (i32.const 2))
      (i32.sub (local.get $gainLength) (i32.const 2)))
    (local.get $total))

  ;; Internal bridges mirror the public ISO routines without resetting error
  ;; state during a composed package operation.
  (func $gain_iso_encode_bridge (param $metadata i32) (param $output i32) (param $capacity i32) (result i32)
    (call $gain_map_iso_encode_export (local.get $metadata) (local.get $output) (local.get $capacity)))
  (func $gain_iso_decode_bridge (param $bytes i32) (param $length i32) (param $metadata i32) (result i32)
    (call $gain_map_iso_decode_export (local.get $bytes) (local.get $length) (local.get $metadata)))

