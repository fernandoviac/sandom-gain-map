  ;; @sandom/gain-map standalone runtime. The two synchronous, whole-image
  ;; codec effects are the complete host import surface.
  (import "gain_map" "jpeg_encode" (func $host_jpeg_encode (param i32) (result i32)))
  (import "gain_map" "jpeg_decode" (func $host_jpeg_decode (param i32) (result i32)))
  (memory (export "memory") 2 4096)
  (global $COLOR_BASE i32 (i32.const 0))
  (global $gain_initialized (mut i32) (i32.const 0))
  (global $gain_error (mut i32) (i32.const 0))
  (global $gain_field (mut i32) (i32.const 0))
  (global $gain_required (mut i32) (i32.const 0))
  (global $gain_heap (mut i32) (i32.const 65536))
  (global $gain_first (mut i32) (i32.const 0))
  (global $gain_last (mut i32) (i32.const 0))
  (global $gain_limit (mut i32) (i32.const 268435456))

  (func $gain_begin
    (global.set $gain_error (i32.const 0))
    (global.set $gain_field (i32.const 0))
    (global.set $gain_required (i32.const 0)))
  (func $gain_fail (param $code i32) (param $field i32) (result i32)
    (global.set $gain_error (local.get $code))
    (global.set $gain_field (local.get $field))
    (local.get $code))
  (func $gain_span (param $ptr i32) (param $length i32) (result i32)
    (i64.le_u
      (i64.add (i64.extend_i32_u (local.get $ptr)) (i64.extend_i32_u (local.get $length)))
      (i64.shl (i64.extend_i32_u (memory.size)) (i64.const 16))))
  (func $gain_nonoverlap (param $a i32) (param $alen i32) (param $b i32) (param $blen i32) (result i32)
    (i32.or
      (i64.le_u
        (i64.add (i64.extend_i32_u (local.get $a)) (i64.extend_i32_u (local.get $alen)))
        (i64.extend_i32_u (local.get $b)))
      (i64.le_u
        (i64.add (i64.extend_i32_u (local.get $b)) (i64.extend_i32_u (local.get $blen)))
        (i64.extend_i32_u (local.get $a)))))
  (func $gain_finite (param $x f64) (result i32)
    (i32.and (f64.eq (local.get $x) (local.get $x)) (f64.lt (f64.abs (local.get $x)) (f64.const inf))))
  (func $gain_checked_product (param $a i32) (param $b i32) (result i32)
    (local $p i64)
    (local.set $p (i64.mul (i64.extend_i32_u (local.get $a)) (i64.extend_i32_u (local.get $b))))
    (if (i64.gt_u (local.get $p) (i64.const 0x7fffffff)) (then (return (i32.const -1))))
    (i32.wrap_i64 (local.get $p)))
  (func $gain_min_u (param $a i32) (param $b i32) (result i32)
    (if (result i32) (i32.lt_u (local.get $a) (local.get $b))
      (then (local.get $a)) (else (local.get $b))))

  ;; Block headers are capacity,next,live,generation. Freed blocks never move;
  ;; generation increments on reuse so result leases cannot alias stale storage.
  (func $gain_alloc_internal (param $size i32) (result i32)
    (local $block i32) (local $end i32) (local $pages i32)
    (if (i32.or (i32.eqz (local.get $size)) (i32.gt_u (local.get $size) (i32.const 268435424)))
      (then (return (i32.const 0))))
    (local.set $size (i32.and (i32.add (local.get $size) (i32.const 7)) (i32.const -8)))
    (local.set $block (global.get $gain_first))
    (block $fresh
      (loop $next
        (br_if $fresh (i32.eqz (local.get $block)))
        (if (i32.and (i32.eqz (i32.load offset=8 (local.get $block)))
            (i32.ge_u (i32.load (local.get $block)) (local.get $size)))
          (then
            (i32.store offset=8 (local.get $block) (i32.const 1))
            (i32.store offset=12 (local.get $block)
              (i32.add (i32.load offset=12 (local.get $block)) (i32.const 1)))
            (return (i32.add (local.get $block) (i32.const 16)))))
        (local.set $block (i32.load offset=4 (local.get $block)))
        (br $next)))
    (local.set $block (global.get $gain_heap))
    (local.set $end (i32.add (local.get $block) (i32.add (local.get $size) (i32.const 16))))
    (if (i32.or (i32.lt_u (local.get $end) (local.get $block))
        (i32.gt_u (local.get $end) (global.get $gain_limit)))
      (then (return (i32.const 0))))
    (local.set $pages (i32.shr_u (i32.add (local.get $end) (i32.const 65535)) (i32.const 16)))
    (if (i32.gt_u (local.get $pages) (memory.size))
      (then
        (if (i32.eq (memory.grow (i32.sub (local.get $pages) (memory.size))) (i32.const -1))
          (then (return (i32.const 0))))))
    (i32.store (local.get $block) (local.get $size))
    (i32.store offset=4 (local.get $block) (i32.const 0))
    (i32.store offset=8 (local.get $block) (i32.const 1))
    (i32.store offset=12 (local.get $block) (i32.const 1))
    (if (global.get $gain_last)
      (then (i32.store offset=4 (global.get $gain_last) (local.get $block)))
      (else (global.set $gain_first (local.get $block))))
    (global.set $gain_last (local.get $block))
    (global.set $gain_heap (local.get $end))
    (i32.add (local.get $block) (i32.const 16)))
  (func $gain_free_internal (param $ptr i32) (result i32)
    (local $block i32)
    (local.set $block (global.get $gain_first))
    (block $done
      (loop $next
        (br_if $done (i32.eqz (local.get $block)))
        (if (i32.eq (local.get $ptr) (i32.add (local.get $block) (i32.const 16)))
          (then
            (if (i32.eqz (i32.load offset=8 (local.get $block))) (then (return (i32.const 0))))
            (i32.store offset=8 (local.get $block) (i32.const 0))
            (return (i32.const 1))))
        (local.set $block (i32.load offset=4 (local.get $block)))
        (br $next)))
    (i32.const 0))
  (func $gain_block_generation (param $ptr i32) (result i32)
    (local $block i32)
    (local.set $block (global.get $gain_first))
    (block $done
      (loop $next
        (br_if $done (i32.eqz (local.get $block)))
        (if (i32.eq (local.get $ptr) (i32.add (local.get $block) (i32.const 16)))
          (then
            (if (i32.load offset=8 (local.get $block))
              (then (return (i32.load offset=12 (local.get $block)))))
            (return (i32.const 0))))
        (local.set $block (i32.load offset=4 (local.get $block)))
        (br $next)))
    (i32.const 0))

  (func (export "gain_map_init") (result i32)
    (call $gain_begin)
    (if (i32.eqz (global.get $gain_initialized))
      (then (call $colorInit) (global.set $gain_initialized (i32.const 1))))
    (i32.const 0))
  (func (export "gain_map_alloc") (param $size i32) (result i32)
    (local $result i32)
    (call $gain_begin)
    (local.set $result (call $gain_alloc_internal (local.get $size)))
    (if (i32.eqz (local.get $result))
      (then (drop (call $gain_fail (i32.const 10) (local.get $size)))))
    (local.get $result))
  (func (export "gain_map_free") (param $ptr i32) (result i32)
    (call $gain_begin)
    (if (call $gain_free_internal (local.get $ptr))
      (then (return (i32.const 0))))
    (call $gain_fail (i32.const 11) (local.get $ptr)))
  (func (export "gain_map_set_memory_limit") (param $bytes i32) (result i32)
    (call $gain_begin)
    (if (i32.or (i32.lt_u (local.get $bytes) (global.get $gain_heap))
        (i32.gt_u (local.get $bytes) (i32.const 268435456)))
      (then (return (call $gain_fail (i32.const 10) (local.get $bytes)))))
    (global.set $gain_limit (local.get $bytes))
    (i32.const 0))
